---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const { 
  title, 
  description = "Diseño web premium a medida, rediseño de sitios, catálogos digitales, SEO y Google Ads para marcas, inmobiliarias, agencias de autos y negocios.",
  ogImage = "https://wolfim.com/og-image.jpg",
  canonical = "https://wolfim.com/"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="diseño web premium, diseño web a medida, rediseño de sitio web, catálogo digital de productos, catálogo online inmobiliaria, SEO para sitios web, Google Ads, sitios web para agencias de autos">
  <meta name="author" content="Wolfim Studio">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={ogImage}>
  <meta property="og:url" content={canonical}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <link rel="icon" type="image/svg+xml" href="/wolfim_logos/favicom_redsquare.svg">
  <link rel="apple-touch-icon" href="/wolfim_logos/favicom_redsquare.svg">

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-D7E290M8PW"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-D7E290M8PW');
  </script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  
  <link rel="alternate" hreflang="es" href="https://wolfim.com/">
  <link rel="alternate" hreflang="en" href="https://wolfim.com/?lang=en">
  <link rel="alternate" hreflang="x-default" href="https://wolfim.com/">
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Wolfim Studio",
      "url": "https://wolfim.com/",
      "logo": "https://wolfim.com/wolfim_nobg.png",
      "image": "https://wolfim.com/og-image.jpg",
      "description": "Diseño web premium a medida, rediseño de sitios, catálogos digitales, SEO y Google Ads para marcas, inmobiliarias, agencias de autos y negocios.",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "AR"
      },
      "priceRange": "$$$",
      "sameAs": [
        "https://www.instagram.com/wolfim.studio/"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Planes de diseño web premium",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "Presencia Comercial",
            "description": "Sitio premium compacto con propuesta de valor clara, servicios, WhatsApp, formulario y SEO básico. Para PYMES y profesionales.",
            "priceCurrency": "USD",
            "price": "200",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "200",
              "priceCurrency": "USD",
              "referenceQuantity": { "@type": "QuantitativeValue", "value": "1" }
            },
            "url": "https://wolfim.com/#plan-presencia-comercial"
          },
          {
            "@type": "Offer",
            "name": "Loteo Activo",
            "description": "Landing premium con storytelling, ubicación, galería, video, lotes con estados y precios, y campaña Meta inicial. Para desarrollos y lotes.",
            "priceCurrency": "USD",
            "price": "450",
            "url": "https://wolfim.com/#plan-loteo-activo"
          },
          {
            "@type": "Offer",
            "name": "AutoLead Catálogo",
            "description": "Catálogo de unidades con fichas individuales, fotos, datos, precio, WhatsApp por vehículo y panel de actualización. Para agencias de autos.",
            "priceCurrency": "USD",
            "price": "450",
            "url": "https://wolfim.com/#plan-autolead-catalogo"
          },
          {
            "@type": "Offer",
            "name": "Portal Inmobiliario",
            "description": "Home premium con catálogo de propiedades, fichas individuales, filtros, buscador y CMS. Para inmobiliarias.",
            "priceCurrency": "USD",
            "price": "650",
            "url": "https://wolfim.com/#plan-portal-inmobiliario"
          },
          {
            "@type": "Offer",
            "name": "Tienda Online",
            "description": "Catálogo de productos con carrito, checkout, pagos online, gestión de pedidos y panel administrativo. Ecommerce completo.",
            "priceCurrency": "USD",
            "price": "650",
            "url": "https://wolfim.com/#plan-tienda-online"
          }
        ]
      }
    }
  </script>
</head>
<body>
  <slot />
</body>
</html>
