---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Diseño web premium a medida, rediseño de sitios, catálogos digitales, SEO y Google Ads para marcas, inmobiliarias, agencias de autos y negocios." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="diseño web premium, diseño web a medida, rediseño de sitio web, catálogo digital de productos, catálogo online inmobiliaria, SEO para sitios web, Google Ads, sitios web para agencias de autos">
  <meta name="author" content="Wolfim Studio">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://wolfim.com/">
  <meta property="og:title" content="Wolfim Studio — Diseño web premium y catálogos digitales">
  <meta property="og:description" content="Sitios web a medida, rediseños, catálogos online y SEO para negocios que necesitan una presencia digital clara, rápida y comercial.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://wolfim.com/og-image.jpg">
  <meta property="og:url" content="https://wolfim.com/">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://wolfim.com/og-image.jpg">
  <link rel="icon" type="image/png" href="/wolfim_nobg.png">
  <link rel="apple-touch-icon" href="/wolfim_nobg.png">

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-D7E290M8PW"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-D7E290M8PW');
  </script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  
  <link rel="alternate" hreflang="es" href="https://wolfim.com/">
  <link rel="alternate" hreflang="en" href="https://wolfim.com/?lang=en">
  <link rel="alternate" hreflang="x-default" href="https://wolfim.com/">
  <!-- Schema Markup (JSON-LD) -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Wolfim Studio",
      "url": "https://wolfim.com/",
      "logo": "https://wolfim.com/wolfim_nobg.png",
      "image": "https://wolfim.com/og-image.jpg",
      "description": "Diseño web premium a medida, rediseño de sitios, catálogos digitales, SEO y Google Ads para marcas, inmobiliarias, agencias de autos y negocios.",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "AR"
      },
      "priceRange": "$$$",
      "sameAs": [
        "https://www.instagram.com/wolfim.studio/"
      ]
    }
  </script>
</head>
<body>
  <slot />
</body>
</html>
