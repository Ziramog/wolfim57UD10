---
import '../styles/global.css';
import { buildTrackingBootstrap } from '../lib/tracking-config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const { 
  title, 
  description = "Estrategia, diseño y tecnología para mejorar cómo tu negocio se presenta, vende y opera. Soluciones para B2B, B2C y operaciones mixtas.",
  ogImage = "https://www.wolfim.com/og-image.jpg",
  canonical
} = Astro.props;

// Canonical/hreflang por página: si la página no pasa `canonical`, se deriva de
// su propia ruta. Antes todas las páginas apuntaban al home.
// El host canónico es `www`: `wolfim.com` responde 308 → `www.wolfim.com`, así
// que usar el apex en canonical/hreflang/sitemap generaba "página con
// redirección" en Search Console (nit 2 de la revisión 2026-10-27).
const SITE_ORIGIN = 'https://www.wolfim.com';
const rawPath = Astro.url?.pathname || '/';
const normalizedPath = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '');
const canonicalUrl = canonical || `${SITE_ORIGIN}${normalizedPath}`;

// GA4 con allowlist de hosts: el tag solo se carga en www.wolfim.com /
// wolfim.com; en cualquier otro host se emite warning + banner visible.
const trackingBootstrap = buildTrackingBootstrap();
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="estudio de negocios digitales, estrategia digital, identidad de marca, diseño web, soluciones B2B, ecommerce B2C, desarrollo de tecnología, catálogos digitales, transformación digital">
  <meta name="author" content="Wolfim Studio">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={ogImage}>
  <meta property="og:url" content={canonicalUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <link rel="icon" type="image/svg+xml" href="/wolfim_logos/favicom_redsquare.svg">
  <link rel="apple-touch-icon" href="/wolfim_logos/favicom_redsquare.svg">

  <!-- Google tag (gtag.js) con allowlist de hosts — ver src/lib/tracking-config.ts -->
  <script is:inline set:html={trackingBootstrap}></script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  
  <link rel="alternate" hreflang="es" href={canonicalUrl}>
  <link rel="alternate" hreflang="x-default" href={canonicalUrl}>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "WOLFIM / 57UD10",
      "url": "https://www.wolfim.com/",
      "logo": "https://www.wolfim.com/wolfim_logos/WOLFIM_57UD10_OFICIAL_4K.png",
      "description": "Estudio de negocios digitales: estrategia, diseño y tecnología para marcas, canales y operaciones B2B, B2C y mixtas.",
      "address": { "@type": "PostalAddress", "addressCountry": "AR" },
      "sameAs": ["https://www.instagram.com/wolfim.studio/"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Capacidades digitales",
        "itemListElement": [
          { "@type": "OfferCatalog", "name": "Estrategia" },
          { "@type": "OfferCatalog", "name": "Diseño" },
          { "@type": "OfferCatalog", "name": "Tecnología" }
        ]
      }
    }
  </script>
</head>
<body>
  <slot />
</body>
</html>
