---
/**
 * WOLFIM Digital 360 — sourced from strategic master plan v2, 28 Oct 2026.
 * All offers are conceptual service scopes: not proof of implemented deployments.
 */
const modules = [
  {n:'01',key:'systems',name:'Sistemas empresariales',detail:'Paneles, presupuestos, pedidos y permisos para ordenar operaciones.'},
  {n:'02',key:'crm',name:'CRM y automatización',detail:'Oportunidades, tareas, responsables y seguimiento comercial.'},
  {n:'03',key:'b2b',name:'Comercio B2B',detail:'Portal mayorista, listas por cliente, pedidos y cotizaciones.'},
  {n:'04',key:'b2c',name:'Comercio B2C',detail:'Ecommerce, pagos, envíos y postventa.'},
  {n:'05',key:'ml',name:'Mercado Libre',detail:'Publicaciones, operación del canal e inteligencia competitiva validada.'},
  {n:'06',key:'data',name:'Integración y analítica',detail:'Catálogos, inventario, tableros y conexiones según factibilidad.'},
];
---
<section id="transformacion-360" class="wolfim-v8-360" aria-labelledby="wolfim-v8-360-heading">
  <div class="wolfim-v8-360__shell">
    <div class="wolfim-v8-360__eyebrow">
      <span>05 / <span data-i18n="v8.360.eyebrow">TRANSFORMACIÓN COMERCIAL DIGITAL 360°</span></span>
      <span>WOLFIM / 57UD10</span>
    </div>
    <div class="wolfim-v8-360__intro" data-kinetic-scroll>
      <div>
        <div class="wolfim-v8-360__tag" data-i18n="v8.360.tag">SISTEMAS + COMERCIO</div>
        <h2 id="wolfim-v8-360-heading">
          <span data-i18n="v8.360.title1">Tu negocio evolucionó.</span>
          <strong data-i18n="v8.360.title2">¿Tus sistemas también?</strong>
        </h2>
      </div>
      <div class="wolfim-v8-360__side">
        <p data-i18n="v8.360.description">Digitalizamos cómo tu empresa se presenta, vende y opera. Conectamos procesos, canales y tecnología con una implementación por etapas.</p>
        <a href="#contact">
          <span data-i18n="v8.360.cta">Hablemos de tu diagnóstico 360°</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="wolfim-v8-360__continuity" data-kinetic-scroll>
      <span data-i18n="v8.360.bridge">UN SISTEMA. SEIS CAPACIDADES.</span>
      <span>01 — 06</span>
    </div>
    <div class="wolfim-v8-360__modules">
      {modules.map(m => (
        <article class="wolfim-v8-360__module" data-kinetic-scroll data-kinetic-order={Number(m.n) - 1} data-kinetic-distance="46">
          <div class="wolfim-v8-360__module-head">
            <span>{m.n} / 06</span>
            <span class="wolfim-v8-360__glyph" aria-hidden="true">↗</span>
          </div>
          <h3 data-i18n={'v8.360.'+m.key+'.title'}>{m.name}</h3>
          <p data-i18n={'v8.360.'+m.key+'.description'}>{m.detail}</p>
        </article>
      ))}
    </div>
    <div class="wolfim-v8-360__base">
      <span data-i18n="v8.360.arch">CANALES → PROCESOS → GESTIÓN</span>
      <p data-i18n="v8.360.scope">Integramos con sistemas existentes o desarrollamos módulos específicos según diagnóstico y viabilidad técnica. No proponemos un ERP completo por defecto.</p>
    </div>
  </div>
</section>

<style>
  .wolfim-v8-360 {background:#E61E1E;color:#fff;padding:clamp(82px,9vw,146px) 0 clamp(75px,8vw,125px);scroll-margin-top:68px;font-family:'Inter',Arial,sans-serif;}
  :global(body.wolfim-v8-360-visible .whatsapp-sticky) {visibility:hidden !important;opacity:0 !important;pointer-events:none !important;}
  .wolfim-v8-360__shell {width:min(1350px,calc(100% - clamp(36px,7vw,120px)));margin-inline:auto;}
  .wolfim-v8-360__eyebrow {display:flex;justify-content:space-between;gap:20px;padding-bottom:21px;border-bottom:1px solid rgba(255,255,255,.53);font:700 clamp(.65rem,.78vw,.8rem)/1.5 'JetBrains Mono',monospace;letter-spacing:.065em;}
  .wolfim-v8-360__intro {display:grid;grid-template-columns:minmax(0,1.5fr) minmax(250px,.5fr);align-items:end;gap:clamp(25px,5vw,100px);padding:clamp(55px,6vw,98px) 0 clamp(48px,6vw,84px);}
  .wolfim-v8-360__tag {font:750 clamp(.7rem,.95vw,.91rem)/1.4 'JetBrains Mono',monospace;letter-spacing:.12em;margin-bottom:25px;}
  .wolfim-v8-360 h2 {margin:0;font-size:clamp(3.1rem,6vw,7.3rem);line-height:1.02;letter-spacing:-.068em;font-weight:900;}
  .wolfim-v8-360 h2 span,.wolfim-v8-360 h2 strong {display:block;font:inherit;}
  .wolfim-v8-360 h2 strong {color:#161616;margin-top:.13em;}
  .wolfim-v8-360__side p {margin:0;font-size:clamp(1rem,1.25vw,1.12rem);line-height:1.6;max-width:400px;}
  .wolfim-v8-360__side a {display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:30px;padding:16px 0;border-top:1px solid rgba(255,255,255,.66);border-bottom:1px solid rgba(255,255,255,.66);font-size:.85rem;font-weight:800;color:#fff;text-decoration:none;}
  .wolfim-v8-360__side a:hover {color:#111;}
  .wolfim-v8-360__side a:focus-visible {outline:3px solid #111;outline-offset:4px;}
  .wolfim-v8-360__continuity {display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 0 18px;font:750 clamp(.65rem,.82vw,.8rem)/1.45 'JetBrains Mono',monospace;letter-spacing:.085em;border-bottom:1px solid rgba(255,255,255,.4);margin-bottom:16px;}
  .wolfim-v8-360__continuity span:last-child {color:#fff;}
  .wolfim-v8-360__modules {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2px;background:rgba(255,255,255,.42);border:2px solid rgba(255,255,255,.42);}
  .wolfim-v8-360__module {position:relative;background:#181818;color:#fff;min-height:265px;padding:clamp(22px,2.8vw,40px);display:flex;flex-direction:column;transition:background .24s ease;}
  .wolfim-v8-360__module::before {content:'';position:absolute;top:0;left:0;right:0;height:3px;background:#E61E1E;transform:scaleX(0);transform-origin:left;transition:transform .48s cubic-bezier(.16,1,.3,1);}
  .wolfim-v8-360__module:hover::before {transform:scaleX(1);}
  .wolfim-v8-360__module:hover {background:#252525;}
  .wolfim-v8-360__module-head {display:flex;justify-content:space-between;align-items:start;color:#b9b9b7;font:700 .7rem/1.3 'JetBrains Mono',monospace;}
  .wolfim-v8-360__glyph {font-size:1.15rem;color:#E61E1E;}
  .wolfim-v8-360__module h3 {margin:auto 0 12px;font-size:clamp(1.45rem,2.15vw,2.3rem);line-height:1.08;font-weight:850;letter-spacing:-.055em;}
  .wolfim-v8-360__module p {margin:0;color:#bdbdb9;line-height:1.55;font-size:.92rem;max-width:340px;}
  .wolfim-v8-360__base {display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:20px 55px;align-items:start;border-top:1px solid rgba(255,255,255,.6);padding-top:27px;margin-top:clamp(36px,5vw,72px);}
  .wolfim-v8-360__base span {font:750 clamp(.7rem,1vw,.93rem)/1.55 'JetBrains Mono',monospace;letter-spacing:.06em;}
  .wolfim-v8-360__base p {font-size:.86rem;line-height:1.6;margin:0;color:#fff;max-width:650px;}
  @media(max-width:930px){
    .wolfim-v8-360__intro {grid-template-columns:1fr;gap:25px;}
    .wolfim-v8-360__side {max-width:650px;}
    .wolfim-v8-360__modules {grid-template-columns:repeat(2,minmax(0,1fr));}
  }
  @media(max-width:600px){
    .wolfim-v8-360__eyebrow>span:last-child {display:none;}
    .wolfim-v8-360 h2 {font-size:clamp(2.8rem,11.3vw,4.3rem);}
    .wolfim-v8-360__tag {margin-bottom:16px;}
    .wolfim-v8-360__modules {grid-template-columns:1fr;}
    .wolfim-v8-360__module {min-height:195px;padding:25px;}
    .wolfim-v8-360__continuity {font-size:.62rem;letter-spacing:.035em;}
    .wolfim-v8-360__module h3 {font-size:1.7rem;}
    .wolfim-v8-360__base {grid-template-columns:1fr;}
  }
  @media(prefers-reduced-motion:reduce){
    .wolfim-v8-360__module {transition:none;}
    .wolfim-v8-360__module::before {transition:none;}
  }
</style>

<script>
  const digital360 = document.getElementById('transformacion-360');
  const whatsApp = document.querySelector<HTMLElement>('.whatsapp-sticky');
  if (digital360) {
    const observer = new IntersectionObserver(entries => {
      const visible = !!entries[0]?.isIntersecting;
      document.body.classList.toggle('wolfim-v8-360-visible', visible);
      if (whatsApp) whatsApp.inert = ['wolfim-v5-hero-visible','wolfim-v7-contact-visible','wolfim-v8-360-visible','wolfim-v9-method-visible'].some(c=>document.body.classList.contains(c));
    }, {threshold:0});
    observer.observe(digital360);
  }
</script>
