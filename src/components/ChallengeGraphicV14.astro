---
/**
 * WOLFIM V14 / Visión sistémica.
 * Obra vectorial original con parallax por capas, no captura ni dependencias de React.
 * Los nodos son una metáfora de conexiones, no interfaces de software ni integraciones verificadas.
 */
---
<div class="v14-network" data-v14-network role="img" aria-labelledby="v14-graphic-alt">
  <span id="v14-graphic-alt" class="v14-network__sr" data-i18n="v14.graph.alt">Gráfico conceptual: marca, canales, operación y datos conectados por una dirección comercial.</span>
  <div class="v14-network__micro v14-network__micro--top" aria-hidden="true">
    <span data-i18n="v14.graph.top">WOLFIM / VISIÓN 360°</span>
    <span data-i18n="v14.graph.fig">FIG. 01 — SISTEMA COMERCIAL</span>
  </div>

  <div class="v14-network__lattice" data-v14-depth="9" aria-hidden="true"></div>

  <svg class="v14-network__wires" viewBox="0 0 640 545" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <circle cx="318" cy="272" r="192" stroke="#ffffff" stroke-opacity=".055"/>
    <circle cx="318" cy="272" r="146" stroke="#ffffff" stroke-opacity=".13" stroke-dasharray="3 11"/>
    <circle cx="318" cy="272" r="104" stroke="#ffffff" stroke-opacity=".09"/>
    <path d="M140 159 C210 166 218 211 285 244" stroke="#777777" stroke-opacity=".43" stroke-width="1.2" stroke-dasharray="2 7"/>
    <path d="M500 152 C433 166 414 207 352 244" stroke="#777777" stroke-opacity=".43" stroke-width="1.2" stroke-dasharray="2 7"/>
    <path d="M147 384 C213 367 227 328 285 299" stroke="#777777" stroke-opacity=".43" stroke-width="1.2" stroke-dasharray="2 7"/>
    <path d="M494 388 C425 366 413 328 352 299" stroke="#777777" stroke-opacity=".43" stroke-width="1.2" stroke-dasharray="2 7"/>
    <path class="v14-network__livewire" d="M140 159 C210 166 218 211 285 244" pathLength="1"/>
    <path class="v14-network__livewire" d="M500 152 C433 166 414 207 352 244" pathLength="1"/>
    <path class="v14-network__livewire" d="M147 384 C213 367 227 328 285 299" pathLength="1"/>
    <path class="v14-network__livewire" d="M494 388 C425 366 413 328 352 299" pathLength="1"/>
    <path d="M317 61v31 M317 452v33 M111 272h32 M493 272h31" stroke="#EF3030" stroke-width="1.6" stroke-opacity=".68"/>
    <circle cx="140" cy="159" r="3.5" fill="#E61E1E"/><circle cx="500" cy="152" r="3.5" fill="#E61E1E"/>
    <circle cx="147" cy="384" r="3.5" fill="#E61E1E"/><circle cx="494" cy="388" r="3.5" fill="#E61E1E"/>
  </svg>

  <div class="v14-network__node v14-network__node--brand" data-v14-depth="-16" aria-hidden="true">
    <span class="v14-network__node-id"><i></i> <span data-i18n="v14.graph.n1">01 / MARCA</span></span>
    <strong data-i18n="v14.graph.n1.title">Identidad</strong>
    <small data-i18n="v14.graph.n1.sub">Cómo te ven</small>
  </div>
  <div class="v14-network__node v14-network__node--channels" data-v14-depth="21" aria-hidden="true">
    <span class="v14-network__node-id"><i></i> <span data-i18n="v14.graph.n2">02 / CANALES</span></span>
    <strong data-i18n="v14.graph.n2.title">Comercio</strong>
    <small data-i18n="v14.graph.n2.sub">Cómo vendés</small>
  </div>
  <div class="v14-network__node v14-network__node--operations" data-v14-depth="19" aria-hidden="true">
    <span class="v14-network__node-id"><i></i> <span data-i18n="v14.graph.n3">03 / OPERACIÓN</span></span>
    <strong data-i18n="v14.graph.n3.title">Procesos</strong>
    <small data-i18n="v14.graph.n3.sub">Cómo operás</small>
  </div>
  <div class="v14-network__node v14-network__node--data" data-v14-depth="-14" aria-hidden="true">
    <span class="v14-network__node-id"><i></i> <span data-i18n="v14.graph.n4">04 / DATOS</span></span>
    <strong data-i18n="v14.graph.n4.title">Inteligencia</strong>
    <small data-i18n="v14.graph.n4.sub">Cómo decidís</small>
  </div>

  <div class="v14-network__core" data-v14-depth="-9" aria-hidden="true">
    <span class="v14-network__core-overline" data-i18n="v14.graph.core">UNA DIRECCIÓN</span>
    <strong>360<span>°</span></strong>
    <span class="v14-network__core-underline" data-i18n="v14.graph.core.sub">NEGOCIOS CONECTADOS</span>
  </div>

  <div class="v14-network__micro v14-network__micro--bottom" aria-hidden="true">
    <span data-i18n="v14.graph.footer">ESTRATEGIA / DISEÑO / TECNOLOGÍA</span>
    <span class="v14-network__live-led" data-i18n="v14.graph.status">CONEXIONES EN MOVIMIENTO</span>
  </div>
</div>

<style>
  .v14-network__sr{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap;}
  .v14-network{
    position:relative; isolation:isolate; width:100%; aspect-ratio:640/545; min-width:0;
    background:
      radial-gradient(ellipse at 50% 51%,rgba(225,29,29,.14) 0%,rgba(225,29,29,.045) 20%,transparent 51%),
      linear-gradient(145deg,#222322 0%,#191a19 65%,#171817 100%);
    border:1px solid #454644;overflow:hidden;
    box-shadow:0 28px 80px rgba(0,0,0,.33),inset 0 0 0 1px rgba(255,255,255,.02);
    color:#f4f4f1;font-family:'Inter',Arial,sans-serif;
    --v14-wires:.95;
  }
  .v14-network::before,.v14-network::after{content:"";pointer-events:none;position:absolute;z-index:6;width:22px;height:22px;border-color:#ee302e;border-style:solid;}
  .v14-network::before{left:13px;top:13px;border-width:1px 0 0 1px;}
  .v14-network::after{right:13px;bottom:13px;border-width:0 1px 1px 0;}
  .v14-network__lattice{
    position:absolute;inset:-35px;pointer-events:none;opacity:.53;
    background-image:linear-gradient(#ffffff0c 1px,transparent 1px),linear-gradient(90deg,#ffffff0c 1px,transparent 1px);
    background-size:34px 34px;mask-image:radial-gradient(ellipse at center,#000 17%,transparent 75%);
    transform:translate3d(0,var(--v14-y,0px),0);
  }
  .v14-network__wires{position:absolute;inset:0;width:100%;height:100%;z-index:1;overflow:visible;}
  .v14-network__livewire{stroke:#f23735;stroke-width:2.2;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:var(--v14-offset,.65);filter:drop-shadow(0 0 6px #e61e1e99);}
  .v14-network__micro{position:absolute;left:5%;right:5%;display:flex;justify-content:space-between;align-items:center;gap:12px;z-index:5;color:#a5a59e;font:650 clamp(.52rem,.78vw,.68rem)/1.5 'JetBrains Mono',monospace;letter-spacing:.09em;}
  .v14-network__micro--top{top:6%;}.v14-network__micro--bottom{bottom:5%;border-top:1px solid #55554e80;padding-top:11px;}
  .v14-network__live-led::before{content:"";display:inline-block;margin-right:7px;border-radius:50%;width:5px;height:5px;background:#f03937;box-shadow:0 0 9px #e61e1e;}
  .v14-network__node{
    position:absolute;z-index:3;width:31%;min-height:86px;
    padding:12px clamp(10px,1.4vw,17px) 11px;
    background:linear-gradient(135deg,rgba(52,53,51,.98),rgba(33,34,33,.96));
    border:1px solid rgba(212,213,207,.28);
    box-shadow:0 12px 28px rgba(0,0,0,.28);
    display:flex;flex-direction:column;gap:5px;
    transform:translate3d(0,var(--v14-y,0px),0);
  }
  .v14-network__node--brand{left:5.6%;top:20%;}
  .v14-network__node--channels{right:5.5%;top:19%;}
  .v14-network__node--operations{left:6.6%;bottom:19%;}
  .v14-network__node--data{right:6.3%;bottom:18.5%;}
  .v14-network__node-id{font:750 clamp(.48rem,.64vw,.65rem)/1.2 'JetBrains Mono',monospace;letter-spacing:.07em;color:#d5d5ce;}
  .v14-network__node-id i{display:inline-block;vertical-align:1px;width:5px;height:5px;background:#e61e1e;margin-right:5px;}
  .v14-network__node strong{font-size:clamp(.84rem,1.55vw,1.45rem);font-weight:800;letter-spacing:-.06em;line-height:1.06;white-space:nowrap;}
  .v14-network__node small{font-size:clamp(.55rem,.76vw,.77rem);color:#a9a9a3;}
  .v14-network__core{
    position:absolute;z-index:4;left:50%;top:50%;width:26%;aspect-ratio:1;min-width:0;
    border:1px solid #ef413f;border-radius:50%;
    background:radial-gradient(circle at 50% 38%,#502322,#261a1a 55%,#171616 100%);
    box-shadow:0 0 0 9px #141515,0 0 0 10px #f238384d,0 0 75px rgba(230,30,30,.19),inset 0 0 40px rgba(230,30,30,.16);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    transform:translate3d(-50%,calc(-50% + var(--v14-y,0px)),0);
    text-align:center;
  }
  .v14-network__core-overline,.v14-network__core-underline{font:750 clamp(.38rem,.55vw,.55rem)/1.2 'JetBrains Mono',monospace;letter-spacing:.07em;color:#e2d6d3;}
  .v14-network__core strong{font-size:clamp(3.4rem,6.7vw,6.4rem);font-weight:900;line-height:1.1;letter-spacing:-.105em;}
  .v14-network__core strong span{color:#f03937;}
  .v14-network__core-underline{font-size:clamp(.36rem,.48vw,.48rem);letter-spacing:.035em;color:#c9bbb9;}
  @media(max-width:640px){
    .v14-network{aspect-ratio:640/580;}
    .v14-network__node{width:32%;min-height:64px;padding:9px;}
    .v14-network__node strong{font-size:clamp(.77rem,3.3vw,1.07rem);}
    .v14-network__node small{font-size:clamp(.52rem,2.25vw,.72rem);}
    .v14-network__node-id{font-size:clamp(.47rem,1.9vw,.57rem);}
    .v14-network__core{width:28%;box-shadow:0 0 0 6px #141515,0 0 0 7px #f238384d,0 0 45px #e61e1e33;}
    .v14-network__core strong{font-size:clamp(3rem,11vw,4.5rem);}
    .v14-network__core-overline,.v14-network__core-underline{font-size:.34rem;}
    .v14-network__micro{font-size:.46rem;}
    .v14-network__micro--bottom span:first-child{max-width:65%;}
    .v14-network__node--operations{bottom:21%;}
    .v14-network__node--data{bottom:21%;}
  }
  @media(prefers-reduced-motion:reduce){
    .v14-network__lattice,.v14-network__node,.v14-network__core{--v14-y:0px !important;}
    .v14-network{--v14-offset:0 !important;}
  }
</style>

<script>
  const visual=document.querySelector<HTMLElement>('[data-v14-network]');
  if (visual) {
    const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
    const layers=Array.from(visual.querySelectorAll<HTMLElement>('[data-v14-depth]'));
    let active=false, frame=0;
    const render=()=>{
      frame=0;
      if (motion.matches) {
        visual.style.setProperty('--v14-offset','0');
        layers.forEach(layer=>layer.style.setProperty('--v14-y','0px'));
        return;
      }
      if (!active || document.hidden) return;
      const r=visual.getBoundingClientRect();
      const travel=Math.min(1,Math.max(0,(innerHeight-r.top)/(innerHeight+r.height)));
      const parallax=(travel-.5)*2;
      layers.forEach(layer=>{
        const depth=Number(layer.dataset.v14Depth)||0;
        layer.style.setProperty('--v14-y',(parallax*depth).toFixed(2)+'px');
      });
      visual.style.setProperty('--v14-offset',String(Math.max(0,1-Math.min(1,travel*1.45))));
    };
    const queue=()=>{if(active&&!frame)frame=requestAnimationFrame(render);};
    const observer=new IntersectionObserver(entries=>{
      active=!!entries[0]?.isIntersecting;
      if(active)queue();
    },{rootMargin:'20% 0px',threshold:0});
    observer.observe(visual);
    window.addEventListener('scroll',queue,{passive:true});
    window.addEventListener('resize',queue,{passive:true});
    motion.addEventListener('change',()=>{if(frame){cancelAnimationFrame(frame);frame=0;}render();});
    render();
  }
</script>
