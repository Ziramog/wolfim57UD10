---
/**
 * WOLFIM — primer recorrido comercial de la homepage V6.
 * Sin nuevos endpoints ni afirmaciones de proyectos implementados.
 * Cada modelo mantiene una vía de conversación real por WhatsApp.
 */
import Orbit360V15 from './Orbit360V15.astro';
const whatsapp = (text: string) => 'https://wa.me/5493513157202?text=' + encodeURIComponent(text);
---

<section id="desafios" class="wolfim-v6-challenges" aria-labelledby="v6-challenges-title">
  <div class="wolfim-v6-wrap">
    <div class="wolfim-v6-sectionhead">
      <span class="wolfim-v6-eyebrow">01 / <span data-i18n="v6.challenges.eyebrow">DESAFÍOS REALES</span></span>
      <span class="wolfim-v6-aside" data-i18n="v6.challenges.aside">CANALES + SISTEMAS / 360°</span>
    </div>
    <div class="wolfim-v15-layout">
      <div class="wolfim-v6-challenges__heading wolfim-v15-copy" data-kinetic-scroll>
        <h2 id="v6-challenges-title" data-i18n="v6.challenges.title">Cuando los canales no se conectan, el negocio lo siente.</h2>
        <p data-i18n="v6.challenges.lead">Marca, ventas y operación necesitan avanzar en una misma dirección.</p>
        <p class="wolfim-v6-audience" data-i18n="v6.hero.support">Soluciones para negocios B2B, B2C y operaciones mixtas.</p>
      </div>
      <Orbit360V15 />
    </div>
    <div class="wolfim-v6-challenges__grid">
      <article data-kinetic-scroll data-kinetic-order="0" data-kinetic-distance="55">
        <span>01</span>
        <h3 data-i18n="v6.challenge1.title">Presentación dispersa</h3>
        <p data-i18n="v6.challenge1.body">Una identidad poco clara dificulta que el cliente entienda tu propuesta.</p>
      </article>
      <article data-kinetic-scroll data-kinetic-order="1" data-kinetic-distance="63">
        <span>02</span>
        <h3 data-i18n="v6.challenge2.title">Oportunidades sin seguimiento</h3>
        <p data-i18n="v6.challenge2.body">Consultas y presupuestos sin seguimiento pierden continuidad.</p>
      </article>
      <article data-kinetic-scroll data-kinetic-order="2" data-kinetic-distance="70">
        <span>03</span>
        <h3 data-i18n="v6.challenge3.title">Canales desconectados</h3>
        <p data-i18n="v6.challenge3.body">Tiendas, marketplaces y datos aislados complican cada decisión.</p>
      </article>
    </div>
  </div>
</section>

<section id="soluciones" class="wolfim-v6-solutions" aria-labelledby="v6-solutions-title">
  <span id="capabilities" class="wolfim-v9-legacy-anchor" aria-hidden="true"></span>
  <span id="pricing" class="wolfim-v9-legacy-anchor" aria-hidden="true"></span>
  <div class="wolfim-v6-wrap">
    <div class="wolfim-v6-sectionhead">
      <span class="wolfim-v6-eyebrow">02 / <span data-i18n="v6.solutions.eyebrow">CAPACIDADES INTEGRADAS</span></span>
      <span class="wolfim-v6-aside">WOLFIM / 57UD10</span>
    </div>
    <div class="wolfim-v6-solutions__layout">
      <div class="wolfim-v6-solutions__intro" data-kinetic-scroll>
        <h2 id="v6-solutions-title"><span data-i18n="v6.solutions.title1">Tres disciplinas.</span> <span data-i18n="v6.solutions.title2">Una dirección.</span></h2>
        <p data-i18n="v6.solutions.lead">El alcance se define por el problema de cada empresa, no por una lista predeterminada de servicios.</p>
        <a href="#modelos" data-i18n="v6.solutions.link">Conocer los modelos de negocio</a>
      </div>
      <div class="wolfim-v6-solutions__items" data-kinetic-scroll>
        <article>
          <span>01</span>
          <div>
            <h3 data-i18n="v6.strategy.title">Estrategia</h3>
            <p data-i18n="v6.strategy.body">Diagnóstico comercial, prioridades, arquitectura de canales y decisiones de marca.</p>
          </div>
          <span class="wolfim-v6-solutions__glyph" aria-hidden="true">↗</span>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3 data-i18n="v6.design.title">Diseño</h3>
            <p data-i18n="v6.design.body">Identidad, contenido, interfaces y experiencias para cada audiencia.</p>
          </div>
          <span class="wolfim-v6-solutions__glyph" aria-hidden="true">↗</span>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3 data-i18n="v6.technology.title">Tecnología</h3>
            <p data-i18n="v6.technology.body">Desarrollo, catálogos, herramientas comerciales e integraciones evaluadas por factibilidad.</p>
          </div>
          <span class="wolfim-v6-solutions__glyph" aria-hidden="true">↗</span>
        </article>
      </div>
    </div>
  </div>
</section>

<section id="modelos" class="wolfim-v6-models" aria-labelledby="v6-models-title">
  <div class="wolfim-v6-wrap">
    <div class="wolfim-v6-sectionhead">
      <span class="wolfim-v6-eyebrow">03 / <span data-i18n="v6.models.eyebrow">TU MODELO DE NEGOCIO</span></span>
      <span class="wolfim-v6-aside" data-i18n="v6.models.aside">TRES RECORRIDOS, UN ESTUDIO</span>
    </div>
    <div class="wolfim-v6-models__head" data-kinetic-scroll>
      <h2 id="v6-models-title" data-i18n="v6.models.title">No todos los negocios venden de la misma manera.</h2>
      <p data-i18n="v6.models.lead">Elegí el modelo que más se acerca a tu operación. No son paquetes cerrados: son puntos de partida para conversar.</p>
    </div>
    <div class="wolfim-v6-models__tabs" data-kinetic-scroll role="tablist" aria-label="Modelo comercial">
      <button type="button" id="v6-tab-b2b" role="tab" aria-controls="v6-panel-b2b" aria-selected="true" tabindex="0" data-model-tab="b2b">01 / B2B</button>
      <button type="button" id="v6-tab-b2c" role="tab" aria-controls="v6-panel-b2c" aria-selected="false" tabindex="-1" data-model-tab="b2c">02 / B2C</button>
      <button type="button" id="v6-tab-mixto" role="tab" aria-controls="v6-panel-mixto" aria-selected="false" tabindex="-1" data-model-tab="mixto">03 / B2B + B2C</button>
    </div>
    <div class="wolfim-v6-models__panels">
      <article id="v6-panel-b2b" role="tabpanel" aria-labelledby="v6-tab-b2b" tabindex="0" data-model-panel="b2b">
        <span class="wolfim-v6-models__label" data-i18n="v6.b2b.label">INDUSTRIAS / MAYORISTAS / SERVICIOS</span>
        <div><h3 data-i18n="v6.b2b.title">Más claridad comercial. Menos procesos dispersos.</h3>
          <p data-i18n="v6.b2b.body">Catálogos privados, cotizaciones, CRM, seguimiento y captación sectorial, según las necesidades reales de tu operación.</p></div>
        <a href={whatsapp('Hola WOLFIM, quiero revisar mi proceso comercial B2B.')} data-cta="v6_b2b_conversation" target="_blank" rel="noopener noreferrer"><span data-i18n="v6.b2b.cta">Revisar mi proceso comercial</span> <span aria-hidden="true">↗</span></a>
      </article>
      <article id="v6-panel-b2c" role="tabpanel" aria-labelledby="v6-tab-b2c" tabindex="0" data-model-panel="b2c" hidden>
        <span class="wolfim-v6-models__label" data-i18n="v6.b2c.label">MARCAS / COMERCIOS / CONSUMIDOR FINAL</span>
        <div><h3 data-i18n="v6.b2c.title">Una marca sólida necesita una experiencia de compra a la altura.</h3>
          <p data-i18n="v6.b2c.body">Identidad, ecommerce, catálogos, Mercado Libre y experiencias de venta consistentes entre canales.</p></div>
        <a href={whatsapp('Hola WOLFIM, quiero evaluar mi canal de venta B2C.')} data-cta="v6_b2c_conversation" target="_blank" rel="noopener noreferrer"><span data-i18n="v6.b2c.cta">Evaluar mi canal de venta</span> <span aria-hidden="true">↗</span></a>
      </article>
      <article id="v6-panel-mixto" role="tabpanel" aria-labelledby="v6-tab-mixto" tabindex="0" data-model-panel="mixto" hidden>
        <span class="wolfim-v6-models__label" data-i18n="v6.mixto.label">MAYORISTA + MINORISTA / MULTICANAL</span>
        <div><h3 data-i18n="v6.mixto.title">Dos formas de vender. Una estrategia bien organizada.</h3>
          <p data-i18n="v6.mixto.body">Analizamos catálogos, precios, permisos, stock, cuentas e integraciones respetando las reglas comerciales y jurídicas de cada canal.</p></div>
        <a href={whatsapp('Hola WOLFIM, quiero analizar una operación mixta B2B y B2C.')} data-cta="v6_mixto_conversation" target="_blank" rel="noopener noreferrer"><span data-i18n="v6.mixto.cta">Analizar mi operación multicanal</span> <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </div>
</section>

<style>
  .wolfim-v6-wrap { width:min(1335px,calc(100% - clamp(36px,7vw,120px))); margin:0 auto; }
  .wolfim-v9-legacy-anchor {display:block;position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none;scroll-margin-top:72px;}
  .wolfim-v6-challenges,.wolfim-v6-solutions,.wolfim-v6-models { position:relative; isolation:isolate; scroll-margin-top:68px; font-family:'Inter',Arial,sans-serif; }
  .wolfim-v6-challenges { padding:clamp(88px,10vw,150px) 0 clamp(78px,8vw,130px); color:#121212; background:#FAFAF8; }
  .wolfim-v6-sectionhead { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-bottom:18px; border-bottom:1px solid #c9c9c4; }
  .wolfim-v6-eyebrow,.wolfim-v6-aside { font:650 clamp(.62rem,.74vw,.75rem)/1.5 'JetBrains Mono',monospace; letter-spacing:.09em; }
  .wolfim-v6-eyebrow { color:#242424; }.wolfim-v6-aside { color:#666660; }
  .wolfim-v6-challenges__heading { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(0,.65fr); align-items:end; gap:clamp(2rem,6vw,7rem); padding:clamp(40px,6vw,90px) 0; }
  .wolfim-v6-challenges__heading h2,.wolfim-v6-solutions__intro h2,.wolfim-v6-models__head h2 { margin:0; font-weight:850; letter-spacing:-.065em; line-height:1.04; }
  .wolfim-v6-challenges__heading h2 { font-size:clamp(2.7rem,5.4vw,6rem); max-width:940px; }
  .wolfim-v6-challenges__heading p,.wolfim-v6-solutions__intro p,.wolfim-v6-models__head p { margin:0; color:#60605b; font-size:clamp(.96rem,1.2vw,1.13rem); line-height:1.65; }
  .wolfim-v6-audience { margin:0 0 24px; font:650 clamp(.7rem,.85vw,.84rem)/1.6 'JetBrains Mono',monospace; letter-spacing:.055em; color:#686861; }
  .wolfim-v6-challenges__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; border:1px solid #d7d7d2; background:#d7d7d2; }
  .wolfim-v6-challenges__grid article { background:#FAFAF8; padding:clamp(25px,3vw,46px); min-height:270px; display:flex; flex-direction:column; align-items:flex-start; }
  .wolfim-v6-challenges__grid article>span { font:650 .7rem/1 'JetBrains Mono',monospace; color:#CA1515; }
  .wolfim-v6-challenges__grid h3 { margin:clamp(25px,3vw,45px) 0 12px; font-size:clamp(1.3rem,1.9vw,1.85rem); font-weight:800; letter-spacing:-.05em; }
  .wolfim-v6-challenges__grid p { margin:0; max-width:335px; font-size:.92rem; line-height:1.6; color:#666661; }
  .wolfim-v6-solutions { background:#111; color:#FAFAF8; padding:clamp(84px,10vw,154px) 0; }
  .wolfim-v6-solutions .wolfim-v6-sectionhead { border-bottom-color:#454545; }
  .wolfim-v6-solutions .wolfim-v6-eyebrow { color:#f3f3f0; }
  .wolfim-v6-solutions .wolfim-v6-aside { color:#aaaaa4; }
  .wolfim-v6-solutions__layout { display:grid; grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr); gap:clamp(3rem,7vw,9rem); padding-top:clamp(50px,6vw,88px); }
  .wolfim-v6-solutions__intro h2 { font-size:clamp(3rem,5.5vw,6.4rem); }
  .wolfim-v6-solutions__intro h2 span { display:block; }
  .wolfim-v6-solutions__intro h2 span:last-child { color:#E61E1E; }
  .wolfim-v6-solutions__intro p { margin:25px 0 30px; color:#bbbbbb; max-width:470px; }
  .wolfim-v6-solutions__intro>a { color:#fff; display:inline-block; font-size:.85rem; font-weight:700; text-underline-offset:5px; }
  .wolfim-v6-solutions__items article { display:grid; grid-template-columns:27px minmax(0,1fr) 20px; gap:clamp(15px,2vw,36px); border-top:1px solid #444; padding:clamp(25px,3.2vw,42px) 0; }
  .wolfim-v6-solutions__items article:last-child { border-bottom:1px solid #444; }
  .wolfim-v6-solutions__items article>span:first-child { color:#999; font:650 .7rem/1.5 'JetBrains Mono',monospace; }
  .wolfim-v6-solutions__items h3 { margin:0 0 8px; font-size:clamp(1.8rem,2.8vw,3.1rem); line-height:1.1; font-weight:800; letter-spacing:-.05em; }
  .wolfim-v6-solutions__items p { margin:0; color:#bbb; font-size:.94rem; line-height:1.6; max-width:480px; }
  .wolfim-v6-solutions__glyph { color:#E61E1E; font-size:1.15rem; }
  .wolfim-v6-models { padding:clamp(90px,10vw,150px) 0; color:#111; background:#f1f1ee; }
  .wolfim-v6-models__head { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,.6fr); gap:clamp(2rem,6vw,8rem); align-items:end; padding:clamp(48px,6vw,87px) 0; }
  .wolfim-v6-models__head h2 { font-size:clamp(2.8rem,5vw,5.75rem); }
  .wolfim-v6-models__tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:0; border-bottom:1px solid #b7b7b1; }
  .wolfim-v6-models__tabs button { appearance:none; border:0; border-bottom:4px solid transparent; border-radius:0; background:transparent; padding:22px 15px; text-align:left; font:750 clamp(.85rem,1.15vw,1.1rem)/1.3 'Inter',Arial,sans-serif; color:#6c6c67; cursor:pointer; transition:color .2s,border-color .2s; }
  .wolfim-v6-models__tabs button[aria-selected="true"] { color:#111; border-bottom-color:#E61E1E; }
  .wolfim-v6-models__tabs button:hover { color:#111; }
  .wolfim-v6-models__tabs button:focus-visible,.wolfim-v6-models__panels a:focus-visible { outline:3px solid #E61E1E; outline-offset:3px; }
  .wolfim-v6-models__panels article { display:grid; grid-template-columns:minmax(150px,.52fr) minmax(0,1.35fr) minmax(160px,.5fr); align-items:end; gap:clamp(20px,4vw,72px); padding:clamp(42px,6vw,82px) 0; }
  .wolfim-v6-models__panels article[hidden] { display:none !important; }
  .wolfim-v6-models__label { align-self:start; color:#62625d; font:650 clamp(.62rem,.8vw,.77rem)/1.6 'JetBrains Mono',monospace; letter-spacing:.035em; }
  .wolfim-v6-models__panels h3 { margin:0 0 18px; font-size:clamp(2rem,3.3vw,3.8rem); line-height:1.07; font-weight:850; letter-spacing:-.055em; }
  .wolfim-v6-models__panels p { margin:0; color:#5f5f5b; font-size:1rem; line-height:1.65; }
  .wolfim-v6-models__panels a { justify-self:end; display:inline-flex; gap:1.2rem; align-items:center; color:#fff; background:#151515; padding:17px 18px; text-decoration:none; font-size:.78rem; font-weight:750; line-height:1.35; border:1px solid #151515; }
  .wolfim-v6-models__panels a:hover { background:#E61E1E; border-color:#E61E1E; }
  @media(max-width:950px) {
    .wolfim-v6-challenges__heading,.wolfim-v6-models__head { grid-template-columns:1fr; gap:20px; }
    .wolfim-v6-solutions__layout { grid-template-columns:1fr; gap:38px; }
    .wolfim-v6-models__panels article { grid-template-columns:minmax(0,1fr) minmax(0,2fr); }
    .wolfim-v6-models__panels article a { grid-column:2; justify-self:start; }
  }
  @media(max-width:640px) {
    .wolfim-v6-sectionhead { align-items:flex-start; }
    .wolfim-v6-aside { display:none; }
    .wolfim-v6-challenges__grid { grid-template-columns:1fr; }
    .wolfim-v6-challenges__grid article { min-height:0; padding:28px 24px; }
    .wolfim-v6-challenges__grid h3 { margin:17px 0 10px; }
    .wolfim-v6-models__tabs button { padding:17px 5px; font-size:clamp(.69rem,2.8vw,.87rem); }
    .wolfim-v6-models__panels article { grid-template-columns:1fr; gap:20px; padding:40px 0; }
    .wolfim-v6-models__panels article a { grid-column:auto; justify-self:start; }
    .wolfim-v6-challenges__heading h2,.wolfim-v6-models__head h2 { font-size:clamp(2.5rem,10vw,4rem); }
  }
  @media(prefers-reduced-motion:reduce) { .wolfim-v6-models__tabs button { transition:none; } }

  /* V15 / compact editorial section with orbital ecosystem. */
  .wolfim-v6-challenges {
    background:#F1F1ED; color:#111; display:flex; align-items:stretch;
    box-sizing:border-box; scroll-margin-top:0; padding:clamp(78px,8.3vh,96px) 0 clamp(62px,7.9vh,86px);
  }
  .wolfim-v6-challenges>.wolfim-v6-wrap {
    display:grid; grid-template-rows:auto minmax(0,1fr) auto;
    gap:clamp(14px,2vh,25px); width:min(1360px,calc(100% - clamp(36px,7vw,120px)));
  }
  .wolfim-v6-challenges .wolfim-v6-sectionhead {padding-bottom:12px;border-bottom-color:#C4C4BE}
  .wolfim-v6-challenges .wolfim-v6-aside{font-size:.67rem;letter-spacing:.09em}
  .wolfim-v15-layout {display:grid; grid-template-columns:minmax(0,1.06fr) minmax(340px,.94fr);align-items:center;gap:clamp(36px,4vw,76px);min-height:0}
  .wolfim-v6-challenges__heading.wolfim-v15-copy{display:flex;flex-direction:column;align-items:flex-start;gap:clamp(17px,2.5vh,28px);padding:0;min-width:0}
  .wolfim-v6-challenges__heading.wolfim-v15-copy h2 {max-width:680px;font-size:clamp(2.9rem,4.55vw,5.3rem);font-weight:850;line-height:1.04;letter-spacing:-.065em;text-wrap:balance}
  .wolfim-v6-challenges__heading.wolfim-v15-copy>p:not(.wolfim-v6-audience){max-width:490px;color:#52524e;font-size:clamp(.92rem,1.06vw,1.05rem);line-height:1.55}
  .wolfim-v6-challenges__heading .wolfim-v6-audience{margin:0;font:700 clamp(.65rem,.78vw,.77rem)/1.5 'JetBrains Mono',monospace;letter-spacing:.035em;color:#60605a}
  .wolfim-v6-challenges__grid {border-color:#252525;background:#252525;gap:1px;grid-template-columns:repeat(3,minmax(0,1fr))}
  .wolfim-v6-challenges__grid article {min-height:0;padding:clamp(17px,1.8vw,24px) clamp(18px,2.3vw,30px);background:#1B1B1B;color:#F6F6F3}
  .wolfim-v6-challenges__grid article>span {color:#FA5F5F;font-size:.65rem}
  .wolfim-v6-challenges__grid h3 {margin:clamp(13px,1.5vw,19px) 0 6px;font-size:clamp(1rem,1.32vw,1.33rem);font-weight:790;letter-spacing:-.042em;line-height:1.15}
  .wolfim-v6-challenges__grid p {max-width:370px;color:#C4C4BE;font-size:clamp(.77rem,.82vw,.87rem);line-height:1.43}
  @media(min-width:1001px) and (min-height:720px){.wolfim-v6-challenges{height:100svh}}
  @media(max-width:1000px){
    .wolfim-v6-challenges{padding:clamp(74px,8vh,90px) 0 34px;min-height:0}
    .wolfim-v15-layout{grid-template-columns:minmax(0,1fr) minmax(290px,.92fr);gap:20px}
    .wolfim-v6-challenges__heading.wolfim-v15-copy h2{font-size:clamp(2.4rem,4.7vw,3.8rem)}
    .wolfim-v6-challenges__grid article{padding:18px}
    .wolfim-v6-challenges__grid h3{font-size:1rem}
    .wolfim-v6-challenges__grid p{font-size:.78rem}
  }
  @media(max-width:800px){
    .wolfim-v6-challenges{height:auto;min-height:0;padding:75px 0 32px}
    .wolfim-v6-challenges>.wolfim-v6-wrap{gap:17px}
    .wolfim-v15-layout{grid-template-columns:1fr;gap:6px}
    .wolfim-v6-challenges__heading.wolfim-v15-copy{gap:12px}
    .wolfim-v6-challenges__heading.wolfim-v15-copy h2{max-width:700px;font-size:clamp(2.4rem,6.8vw,4.5rem)}
    .wolfim-v6-challenges__heading.wolfim-v15-copy>p:not(.wolfim-v6-audience){max-width:550px;font-size:.94rem}
  }
  @media(max-width:640px){
    .wolfim-v6-challenges {padding:62px 0 23px;min-height:100svh}
    .wolfim-v6-challenges>.wolfim-v6-wrap{display:flex;flex-direction:column;gap:8px;justify-content:flex-start}
    .wolfim-v6-challenges .wolfim-v6-sectionhead{padding-bottom:9px}
    .wolfim-v6-challenges__heading.wolfim-v15-copy{gap:8px}
    .wolfim-v6-challenges__heading.wolfim-v15-copy h2{font-size:clamp(1.95rem,8.1vw,2.65rem);line-height:1.06}
    .wolfim-v6-challenges__heading.wolfim-v15-copy>p:not(.wolfim-v6-audience){font-size:.82rem;line-height:1.43}
    .wolfim-v6-challenges__heading .wolfim-v6-audience{font-size:.58rem}
    .wolfim-v6-challenges__grid{grid-template-columns:1fr;gap:1px}
    .wolfim-v6-challenges__grid article{
      display:grid;grid-template-columns:24px minmax(0,.82fr) minmax(0,1.18fr);
      gap:10px;align-items:center;padding:11px 14px;min-height:0;
    }
    .wolfim-v6-challenges__grid article>span{align-self:center}
    .wolfim-v6-challenges__grid h3{font-size:clamp(.87rem,3.45vw,.98rem);margin:0;line-height:1.18}
    .wolfim-v6-challenges__grid p{font-size:clamp(.67rem,2.75vw,.75rem);line-height:1.35}
  }
  @media(max-width:350px){
    .wolfim-v6-challenges__grid article{grid-template-columns:18px minmax(0,.83fr) minmax(0,1.17fr);gap:7px;padding:10px 8px}
    .wolfim-v6-challenges__grid h3{font-size:.81rem}
    .wolfim-v6-challenges__grid p{font-size:.64rem}
  }
</style>

<script>
  import { trackEvent } from '../lib/analytics';
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-model-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-model-panel]'));
  const select = (model: string, record = false) => {
    buttons.forEach(button => {
      const active = button.dataset.modelTab === model;
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
    });
    panels.forEach(panel => { panel.hidden = panel.dataset.modelPanel !== model; });
    if (record) trackEvent('segment_selected', { segment: model, component: 'home_models_v6' });
  };
  buttons.forEach((button, index) => {
    button.addEventListener('click', () => select(button.dataset.modelTab || 'b2b', true));
    button.addEventListener('keydown', event => {
      if (!['ArrowRight','ArrowLeft','Home','End'].includes(event.key)) return;
      event.preventDefault();
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
      if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = buttons.length - 1;
      const target = buttons[next];
      if (target) { select(target.dataset.modelTab || 'b2b', true); target.focus(); }
    });
  });
  select('b2b');
</script>
