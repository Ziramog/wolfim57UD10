---
/**
 * WOLFIM kinetic editorial system.
 *  - One-time gravity-inspired entrance on the home hero
 *  - Light scroll reveals for the strategic sections
 *  - Reduced motion and non-WAAPI browsers remain fully readable
 *  - Isolated from the physics engine of the draggable brand cube
 */
---

<script>
  type MotionElement = HTMLElement;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const canAnimate = !reduceMotion.matches && typeof Element.prototype.animate === 'function';

  if (canAnimate) {
    const ownAnimations: Animation[] = [];
    const spring = (node: MotionElement, delay: number, distance = 60, duration = 920) => {
      const animation = node.animate([
        { opacity: 0, transform: `translate3d(0,${-distance}px,0)`, offset: 0, easing: 'cubic-bezier(.2,.78,.35,1)' },
        { opacity: 1, transform: 'translate3d(0,12px,0)', offset: .71, easing: 'cubic-bezier(.1,.4,.25,1)' },
        { opacity: 1, transform: 'translate3d(0,-4px,0)', offset: .86, easing: 'ease-out' },
        { opacity: 1, transform: 'translate3d(0,0,0)', offset: 1 },
      ], { delay, duration, fill: 'both', easing: 'linear' });
      ownAnimations.push(animation);
    };

    // The hero builds itself like a deliberate composition. Nothing changes position in the layout.
    const logo = document.querySelector<MotionElement>('[data-kinetic-logo]');
    const kicker = document.querySelector<MotionElement>('[data-kinetic-kicker]');
    const lines = document.querySelectorAll<MotionElement>('[data-kinetic-line]');
    const rule = document.querySelector<MotionElement>('[data-kinetic-rule]');
    const body = document.querySelector<MotionElement>('[data-kinetic-body]');
    const actions = document.querySelector<MotionElement>('[data-kinetic-actions]');
    const systemline = document.querySelector<MotionElement>('[data-kinetic-systemline]');

    if (logo) spring(logo, 90, 85, 1150);
    if (kicker) spring(kicker, 310, 34, 810);
    lines.forEach((line, i) => spring(line, 470 + i * 175, 62 + i * 9, 970));
    if (rule) {
      const lineAnimation = rule.animate([
        { transform: 'scaleX(0)', opacity: .5 },
        { transform: 'scaleX(1)', opacity: 1 },
      ], { delay: 1300, duration: 620, easing: 'cubic-bezier(.2,.75,.2,1)', fill: 'both' });
      ownAnimations.push(lineAnimation);
    }
    if (body) spring(body, 1010, 33, 720);
    if (systemline) spring(systemline, 1160, 18, 650);
    if (actions) spring(actions, 1270, 28, 740);

    const targets = Array.from(document.querySelectorAll<MotionElement>('[data-kinetic-scroll]'));
    const seen = new WeakSet<Element>();
    const io = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as MotionElement;
        if (seen.has(el)) continue;
        seen.add(el);
        io.unobserve(el);
        const distance = Math.min(70, Math.max(32, Number(el.dataset.kineticDistance) || 46));
        // Small stagger belongs to groups of cards, never the entire document.
        const order = Math.max(0, Math.min(4, Number(el.dataset.kineticOrder) || 0));
        spring(el, order * 110, distance, 800);
      }
    }, { threshold: .07, rootMargin: '0px 0px -5% 0px' });
    targets.forEach(el => io.observe(el));

    // Restrained ongoing movement: a 2px red progress track inside the fixed navigation.
    const nav = document.querySelector<HTMLElement>('.nav--v6');
    if (nav) {
      let pendingFrame = false;
      const updateProgress = () => {
        pendingFrame = false;
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        nav.style.setProperty('--wolfim-progress', String(progress));
      };
      const queueProgress = () => {
        if (pendingFrame) return;
        pendingFrame = true;
        requestAnimationFrame(updateProgress);
      };
      window.addEventListener('scroll', queueProgress, { passive: true });
      window.addEventListener('resize', queueProgress, { passive: true });
      updateProgress();
    }

    // Do not leave partially-completed transforms when the user changes this preference.
    reduceMotion.addEventListener('change', () => {
      if (!reduceMotion.matches) return;
      io.disconnect();
      ownAnimations.forEach(animation => { if (animation.playState !== 'finished') animation.finish(); });
    });
  }
</script>
