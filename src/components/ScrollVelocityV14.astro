---
/**
 * Scroll Based Velocity · Adaptación propia para Astro/WOLFIM.
 * Una banda tipográfica editorial cuyo movimiento aumenta y cambia dirección
 * con el desplazamiento vertical. Evita instalar React/Motion en el sitio Astro.
 */
---
<div class="v14-velocity" data-v14-velocity role="img" aria-labelledby="v14-band-alt">
  <span id="v14-band-alt" class="v14-velocity__sr" data-i18n="v14.band.alt">Marca, comercio, operación y datos. Estrategia, diseño, tecnología y crecimiento.</span>
  <div class="v14-velocity__index" aria-hidden="true">
    <span>WOLFIM / 57UD10</span>
    <span data-i18n="v14.band.caption">LOS NEGOCIOS NO FUNCIONAN POR PARTES</span>
    <span>01 / 360°</span>
  </div>
  <div class="v14-velocity__row" data-v14-row data-v14-direction="-1" aria-hidden="true">
    <div class="v14-velocity__track">
      <span class="v14-velocity__repeat"><strong data-i18n="v14.band.brand">MARCA</strong><b>✳</b><strong data-i18n="v14.band.commerce">COMERCIO</strong><b>✳</b><strong data-i18n="v14.band.operations">OPERACIÓN</strong><b>✳</b><strong data-i18n="v14.band.data">DATOS</strong><b>✳</b></span>
      <span class="v14-velocity__repeat"><strong data-i18n="v14.band.brand">MARCA</strong><b>✳</b><strong data-i18n="v14.band.commerce">COMERCIO</strong><b>✳</b><strong data-i18n="v14.band.operations">OPERACIÓN</strong><b>✳</b><strong data-i18n="v14.band.data">DATOS</strong><b>✳</b></span>
      <span class="v14-velocity__repeat"><strong data-i18n="v14.band.brand">MARCA</strong><b>✳</b><strong data-i18n="v14.band.commerce">COMERCIO</strong><b>✳</b><strong data-i18n="v14.band.operations">OPERACIÓN</strong><b>✳</b><strong data-i18n="v14.band.data">DATOS</strong><b>✳</b></span>
    </div>
  </div>
  <div class="v14-velocity__row v14-velocity__row--second" data-v14-row data-v14-direction="1" aria-hidden="true">
    <div class="v14-velocity__track">
      <span class="v14-velocity__repeat"><strong data-i18n="v14.band.strategy">ESTRATEGIA</strong><b>✳</b><strong data-i18n="v14.band.design">DISEÑO</strong><b>✳</b><strong data-i18n="v14.band.technology">TECNOLOGÍA</strong><b>✳</b><strong data-i18n="v14.band.growth">CRECIMIENTO</strong><b>✳</b></span>
      <span class="v14-velocity__repeat"><strong data-i18n="v14.band.strategy">ESTRATEGIA</strong><b>✳</b><strong data-i18n="v14.band.design">DISEÑO</strong><b>✳</b><strong data-i18n="v14.band.technology">TECNOLOGÍA</strong><b>✳</b><strong data-i18n="v14.band.growth">CRECIMIENTO</strong><b>✳</b></span>
      <span class="v14-velocity__repeat"><strong data-i18n="v14.band.strategy">ESTRATEGIA</strong><b>✳</b><strong data-i18n="v14.band.design">DISEÑO</strong><b>✳</b><strong data-i18n="v14.band.technology">TECNOLOGÍA</strong><b>✳</b><strong data-i18n="v14.band.growth">CRECIMIENTO</strong><b>✳</b></span>
    </div>
  </div>
  <div class="v14-velocity__footer" aria-hidden="true">
    <span data-i18n="v14.band.footer">CONEXIÓN DE SISTEMAS / DIRECCIÓN COMERCIAL</span>
    <span><span data-i18n="v14.band.action">SCROLL TO ACTIVATE</span> <span class="v14-velocity__arrow">↘</span></span>
  </div>
</div>
<style>
  .v14-velocity__sr{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap;}
  .v14-velocity{
    position:relative;width:100%;max-width:100%;overflow:hidden;
    background:#f0f0eb;color:#191918;border-top:3px solid #e61e1e;
    border-bottom:1px solid #b9b9b1;contain:paint;
    padding:17px 0 15px;
  }
  .v14-velocity__index,.v14-velocity__footer{
    display:flex;justify-content:space-between;gap:14px;
    padding:0 clamp(24px,4vw,74px);
    font:750 clamp(.56rem,.7vw,.69rem)/1.4 'JetBrains Mono',monospace;
    letter-spacing:.07em;color:#666661;
  }
  .v14-velocity__index{margin-bottom:12px;}
  .v14-velocity__footer{margin-top:14px;}
  .v14-velocity__index span:first-child,.v14-velocity__footer span:last-child{color:#cb1515;}
  .v14-velocity__arrow{font-size:1.2em;vertical-align:middle;}
  .v14-velocity__row{width:100%;overflow:hidden;padding:4px 0;user-select:none;}
  .v14-velocity__row--second{border-top:1px solid #d1d1ca;}
  .v14-velocity__track{
    display:flex;align-items:center;width:max-content;
    transform:translate3d(0,0,0);will-change:transform;
  }
  .v14-velocity__repeat{
    flex:none;display:inline-flex;align-items:center;gap:clamp(18px,3.2vw,60px);
    padding-right:clamp(18px,3.2vw,60px);
    white-space:nowrap;font-family:'Inter',Arial,sans-serif;
    font-size:clamp(2.35rem,5.3vw,5.7rem);font-weight:900;letter-spacing:-.074em;line-height:1.07;
  }
  .v14-velocity__repeat strong{font-weight:900;}
  .v14-velocity__repeat b{font:850 .55em/1 'Inter',Arial,sans-serif;color:#e61e1e;letter-spacing:0;}
  .v14-velocity__row--second .v14-velocity__repeat{
    font-size:clamp(1.8rem,3.6vw,4.35rem);font-weight:850;letter-spacing:-.07em;line-height:1.1;color:#555550;
  }
  .v14-velocity__row--second strong{font-weight:850;}
  @media(max-width:640px){
    .v14-velocity{padding:13px 0 14px;}
    .v14-velocity__index,.v14-velocity__footer{padding:0 18px;gap:9px;}
    .v14-velocity__index span:nth-child(2),.v14-velocity__footer span:nth-child(1){display:none;}
    .v14-velocity__repeat{font-size:2.65rem;gap:24px;padding-right:24px;}
    .v14-velocity__row--second .v14-velocity__repeat{font-size:1.85rem;}
  }
  @media(prefers-reduced-motion:reduce){
    .v14-velocity__track{transform:none !important;will-change:auto;}
    .v14-velocity__footer span:last-child{display:none;}
  }
</style>
<script>
  const ticker=document.querySelector<HTMLElement>('[data-v14-velocity]');
  if (ticker) {
    const rows=Array.from(ticker.querySelectorAll<HTMLElement>('[data-v14-row]'));
    const m=window.matchMedia('(prefers-reduced-motion: reduce)');
    let active=false,raf=0,last=0,lastY=window.scrollY,lastScrollTime=performance.now();
    let direction=1,velocity=0,desired=0;
    const offsets=rows.map((_,i)=>i*125);
    const spans=rows.map(row=>row.querySelector<HTMLElement>('.v14-velocity__repeat'));
    const measure=()=>spans.map(el=>el?.getBoundingClientRect().width||1);
    let widths=measure();
    const stop=()=>{if(raf)cancelAnimationFrame(raf);raf=0;last=0;};
    const tick=(now:number)=>{
      raf=0;
      if (!active||m.matches||document.hidden) return;
      const dt=last?Math.min((now-last)/1000,.05):.016;
      last=now;
      const smoothing=1-Math.exp(-dt*5);
      velocity+=(desired-velocity)*smoothing;
      desired*=Math.exp(-dt*6);
      const rate=13+Math.min(210,Math.abs(velocity)*.16);
      rows.forEach((row,i)=>{
        const width=widths[i]||1;
        const flow=(Number(row.dataset.v14Direction)||1)*direction;
        offsets[i]=((offsets[i]+flow*rate*dt)%width+width)%width;
        const track=row.querySelector<HTMLElement>('.v14-velocity__track');
        if(track)track.style.transform='translate3d('+(-offsets[i]).toFixed(2)+'px,0,0)';
      });
      raf=requestAnimationFrame(tick);
    };
    const play=()=>{if(!raf&&active&&!m.matches&&!document.hidden)raf=requestAnimationFrame(tick);};
    const onScroll=()=>{
      const y=window.scrollY,now=performance.now();
      const delta=y-lastY,dt=Math.max(16,now-lastScrollTime);
      lastY=y;lastScrollTime=now;
      if(Math.abs(delta)>1){
        direction=delta>0?1:-1;
        desired=Math.max(-1700,Math.min(1700,(Math.abs(delta)/dt)*1000));
      }
      if(active)play();
    };
    const reset=()=>{
      if(m.matches){stop();rows.forEach(row=>{
        const track=row.querySelector<HTMLElement>('.v14-velocity__track');
        if(track)track.style.transform='translate3d(0,0,0)';
      });}
      else {widths=measure();play();}
    };
    const io=new IntersectionObserver(entries=>{
      active=!!entries[0]?.isIntersecting;
      if(active){widths=measure();play();}
      else stop();
    },{threshold:0,rootMargin:'15% 0px'});
    io.observe(ticker);
    window.addEventListener('scroll',onScroll,{passive:true});
    window.addEventListener('resize',()=>{widths=measure();},{passive:true});
    document.addEventListener('visibilitychange',()=>document.hidden?stop():play());
    m.addEventListener('change',reset);
    document.fonts?.ready.then(()=>{widths=measure();});
    const labels=new MutationObserver(()=>{widths=measure();rows.forEach((row,i)=>{offsets[i]=offsets[i]%(widths[i]||1);});});
    labels.observe(ticker,{subtree:true,characterData:true,childList:true});
    if(m.matches)reset();
  }
</script>
