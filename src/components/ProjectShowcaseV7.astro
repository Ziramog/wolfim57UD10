---
const demos = [
  {
    key:'r', index:'01', name:'Roggero & Roma', sector:'REAL ESTATE',
    title:'Experiencia inmobiliaria', desc:'Exploración visual de búsqueda, presentación de propiedades y recorridos de consulta.',
    image:'/v7-previews/roggero-roma.jpg', video:'/roggeroyroma_hero2.mp4',
    alt:'Vista previa conceptual de un buscador de propiedades para Roggero & Roma',
  },
  {
    key:'s', index:'02', name:'S&P Cars', sector:'AUTOMOTRIZ',
    title:'Presentación de catálogo', desc:'Concepto audiovisual de una vitrina digital para vehículos y consulta comercial.',
    image:'/v7-previews/sp-cars.jpg', video:'/SPCars.mp4',
    alt:'Visualización conceptual de una interfaz automotriz premium',
  },
  {
    key:'c', index:'03', name:'Construvial', sector:'INDUSTRIA',
    title:'Comunicación industrial', desc:'Estudio de presentación visual para maquinaria, servicios y propuestas comerciales.',
    image:'/v7-previews/construvial.jpg', video:'/construvial-2.mp4',
    alt:'Demostración visual industrial con obras de construcción',
  },
  {
    key:'k', index:'04', name:'Korantis', sector:'PRODUCTO DIGITAL',
    title:'Exploración de interfaz', desc:'Visualización de una experiencia de búsqueda y descubrimiento de lugares.',
    image:'/v7-previews/korantis.jpg', video:'/Korantis_web_UI_showcase.mp4',
    alt:'Propuesta de interfaz digital para descubrir lugares',
  },
];
---

<section id="projects" class="v7-work" aria-labelledby="v7-work-title">
  <span id="testimonials" class="v7-work__legacy-anchor" aria-hidden="true"></span>
  <div class="v7-work__shell">
    <div class="v7-work__overline">
      <span>04 / <span data-i18n="v7.work.label">DIRECCIÓN Y PROYECTOS</span></span>
      <span data-i18n="v7.work.visual">EXPLORACIONES VISUALES</span>
    </div>
    <div class="v7-work__intro" data-kinetic-scroll>
      <h2 id="v7-work-title"><span data-i18n="v7.work.title1">Pensar.</span> <span data-i18n="v7.work.title2">Diseñar.</span> <em data-i18n="v7.work.title3">Hacer.</em></h2>
      <div>
        <p data-i18n="v7.work.intro">La dirección se entiende mejor cuando se puede ver. Estas piezas muestran líneas de exploración en marcas, comercio y productos digitales.</p>
        <p class="v7-work__disclaimer" data-i18n="v7.work.disclaimer">Material visual de referencia. No implica que los proyectos estén publicados ni representa métricas de rendimiento verificadas.</p>
      </div>
    </div>
    <div class="v7-work__grid">
      {demos.map(item => (
        <article class="v7-work__card" data-kinetic-scroll>
          <button
            type="button"
            class="v7-work__visual"
            data-preview-video={item.video}
            data-preview-poster={item.image}
            data-preview-name={item.name}
            aria-label={'Ver vista previa de ' + item.name}
          >
            <img src={item.image} alt={item.alt} loading="lazy" decoding="async" width="1100" height="660" />
            <span class="v7-work__number">{item.index} / 04</span>
            <span class="v7-work__play"><span data-i18n="v7.work.preview">VER PREVISUALIZACIÓN</span><span aria-hidden="true">↗</span></span>
          </button>
          <div class="v7-work__meta">
            <div class="v7-work__identity">
              <span class="v7-work__sector">{item.sector}</span>
              <h3>{item.name}</h3>
            </div>
            <span class="v7-work__status" data-i18n="v7.work.status">MATERIAL EN REVISIÓN</span>
          </div>
          <h4 data-i18n={'v7.work.'+item.key+'.title'}>{item.title}</h4>
          <p data-i18n={'v7.work.'+item.key+'.description'}>{item.desc}</p>
        </article>
      ))}
    </div>
    <div class="v7-work__outro">
      <p data-i18n="v7.work.outro">Cada negocio necesita su propia solución. No repetimos un diseño: construimos una dirección.</p>
      <a href="#contact"><span data-i18n="v7.work.cta">Conversemos sobre tu proyecto</span><span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<dialog id="v7-demo-dialog" class="v7-demo" aria-labelledby="v7-demo-heading">
  <div class="v7-demo__header">
    <div>
      <span data-i18n="v7.work.visual">EXPLORACIONES VISUALES</span>
      <h2 id="v7-demo-heading">Vista previa</h2>
    </div>
    <button type="button" class="v7-demo__close" data-preview-close aria-label="Cerrar vista previa">×</button>
  </div>
  <video class="v7-demo__player" controls playsinline muted preload="none" aria-label="Video de demostración visual"></video>
  <p data-i18n="v7.work.disclaimer">Material visual de referencia. No implica que los proyectos estén publicados ni representa métricas de rendimiento verificadas.</p>
</dialog>

<style>
.v7-work { position:relative; background:#FAFAF8; color:#111; padding:clamp(95px,10vw,160px) 0 clamp(80px,9vw,130px); scroll-margin-top:68px; font-family:'Inter',Arial,sans-serif; }
.v7-work__shell { width:min(1350px,calc(100% - clamp(36px,7vw,120px)));margin:auto; }
.v7-work__legacy-anchor {display:block;position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none;scroll-margin-top:72px;}
.v7-work__overline { display:flex;align-items:center;justify-content:space-between;gap:20px;padding-bottom:18px;border-bottom:1px solid #c9c9c4;font:650 clamp(.65rem,.77vw,.78rem)/1.45 'JetBrains Mono',monospace;letter-spacing:.08em; }
.v7-work__overline span:last-child { color:#71716d; }
.v7-work__intro { display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:clamp(24px,5vw,90px);align-items:end;padding:clamp(42px,6vw,88px) 0 clamp(60px,7vw,110px); }
.v7-work__intro h2 { margin:0;font-size:clamp(3.6rem,8vw,9.5rem);line-height:.99;letter-spacing:-.075em;font-weight:900; }
.v7-work__intro h2 span,.v7-work__intro h2 em { display:block;font-style:normal; }
.v7-work__intro h2 em { color:#E61E1E; }
.v7-work__intro p { margin:0;font-size:clamp(.98rem,1.3vw,1.15rem);line-height:1.65;color:#43433f; }
.v7-work__intro .v7-work__disclaimer { font-size:.76rem;margin-top:22px;color:#81817b; }
.v7-work__grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(50px,6vw,100px) clamp(22px,3vw,50px); }
.v7-work__card { min-width:0; }
.v7-work__visual { position:relative;width:100%;display:block;border:0;border-radius:2px;overflow:hidden;padding:0;cursor:pointer;aspect-ratio:16/10;background:#202020;text-align:left; }
.v7-work__visual img { width:100%;height:100%;object-fit:cover;filter:saturate(.75) contrast(1.04);transition:transform .75s cubic-bezier(.16,1,.3,1),filter .5s ease; }
.v7-work__visual:hover img,.v7-work__visual:focus-visible img { transform:scale(1.055);filter:saturate(1) contrast(1.04); }
.v7-work__visual::after {content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.24),transparent 30%,transparent 55%,rgba(0,0,0,.62));pointer-events:none;}
.v7-work__number { position:absolute;z-index:1;top:18px;left:21px;color:#fff;font:650 .7rem/1.2 'JetBrains Mono',monospace; }
.v7-work__play { position:absolute;z-index:1;left:clamp(15px,2.3vw,30px);right:clamp(15px,2.3vw,30px);bottom:clamp(15px,2.3vw,27px);display:flex;justify-content:space-between;color:#fff;font:700 clamp(.65rem,.86vw,.8rem)/1.5 'JetBrains Mono',monospace;letter-spacing:.06em; }
.v7-work__play span:last-child { font-size:1.3rem; }
.v7-work__meta { display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding-top:24px; }
.v7-work__sector,.v7-work__status { font:650 .64rem/1.35 'JetBrains Mono',monospace;letter-spacing:.075em;color:#797974; }
.v7-work__identity h3 { margin:8px 0 0;font-size:clamp(1.7rem,2.45vw,2.85rem);font-weight:850;line-height:1.08;letter-spacing:-.055em; }
.v7-work__status { text-align:right;color:#B13A39;white-space:nowrap; }
.v7-work__card h4 { margin:18px 0 6px;font-weight:700;font-size:1rem;letter-spacing:-.025em; }
.v7-work__card>p {margin:0;color:#666660;line-height:1.6;font-size:.93rem;max-width:500px;}
.v7-work__outro {display:flex;justify-content:space-between;align-items:end;gap:30px;margin-top:clamp(70px,9vw,140px);padding-top:35px;border-top:1px solid #c8c8c3;}
.v7-work__outro p {max-width:640px;font-size:clamp(1.4rem,2.1vw,2.5rem);line-height:1.22;letter-spacing:-.04em;font-weight:750;}
.v7-work__outro a {display:inline-flex;gap:30px;align-items:center;border-bottom:2px solid #E61E1E;padding:12px 0;font-weight:750;font-size:.88rem;white-space:nowrap;}
.v7-work__outro a:hover {color:#E61E1E;}
.v7-work__visual:focus-visible,.v7-work__outro a:focus-visible {outline:3px solid #E61E1E;outline-offset:4px;}
.v7-demo { position:fixed;inset:0;margin:auto;width:min(1040px,calc(100% - 28px));max-width:1040px;max-height:calc(100dvh - 30px);background:#121212;border:1px solid #494949;color:#fff;padding:clamp(15px,3vw,32px);border-radius:2px;overscroll-behavior:contain; }
.v7-demo::backdrop { background:rgba(0,0,0,.88);backdrop-filter:blur(7px); }
.v7-demo__header {display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px;}
.v7-demo__header span {font:600 .68rem/1.6 'JetBrains Mono',monospace;color:#b6b6b6;}
.v7-demo__header h2 {font-size:clamp(1.5rem,3.2vw,3rem);letter-spacing:-.045em;line-height:1.1;}
.v7-demo__close {border:1px solid #777;color:#fff;background:transparent;width:45px;height:45px;flex:none;font-size:2rem;cursor:pointer;}
.v7-demo__close:hover {background:#E61E1E;border-color:#E61E1E;}
.v7-demo__player {display:block;width:100%;max-height:65vh;background:#050505;aspect-ratio:16/9;}
.v7-demo>p {margin-top:15px;color:#b1b1b1;font-size:.74rem;line-height:1.5;}
@media(max-width:850px) { .v7-work__intro {grid-template-columns:1fr;gap:25px;} }
@media(max-width:660px) {
 .v7-work__grid {grid-template-columns:1fr;gap:50px;}
 .v7-work__overline>span:last-child {display:none;}
 .v7-work__intro h2 {font-size:clamp(3.5rem,13vw,5rem);}
 .v7-work__outro {flex-direction:column;align-items:flex-start;gap:12px;}
 .v7-work__outro a {white-space:normal;}
 .v7-work__status {white-space:normal;max-width:110px;}
}
@media(prefers-reduced-motion:reduce) {
 .v7-work__visual img {transition:none;}
 .v7-work__visual:hover img {transform:none;}
}
</style>

<script>
  import { trackEvent } from '../lib/analytics';
  const dialog = document.getElementById('v7-demo-dialog') as HTMLDialogElement | null;
  const player = dialog?.querySelector('video');
  const heading = document.getElementById('v7-demo-heading');
  const available = new Set(['/roggeroyroma_hero2.mp4','/SPCars.mp4','/construvial-2.mp4','/Korantis_web_UI_showcase.mp4']);
  if (dialog && player && heading) {
    document.querySelectorAll<HTMLButtonElement>('[data-preview-video]').forEach(button => {
      button.addEventListener('click', () => {
        const src = button.dataset.previewVideo || '';
        if (!available.has(src)) return;
        const name = button.dataset.previewName || 'Vista previa';
        heading.textContent = name;
        player.poster = button.dataset.previewPoster || '';
        player.src = src;
        dialog.showModal();
        player.play().catch(() => {});
        trackEvent('portfolio_preview_open', { project: name, component: 'home_v7' });
      });
    });
    const releaseVideo = () => { player.pause(); player.removeAttribute('src'); player.load(); };
    const close = () => { releaseVideo(); dialog.close(); };
    dialog.querySelector('[data-preview-close]')?.addEventListener('click',close);
    dialog.addEventListener('click',e=>{if(e.target===dialog)close();});
    dialog.addEventListener('close', releaseVideo);
  }
</script>
