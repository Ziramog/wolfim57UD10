---
// src/pages/victor/lotes-rio-tercero.astro
const title = "Lotes en Río Tercero | Barrio Marín Marotto | Dueño directo";
const description = "Lotes urbanos en Río Tercero, Barrio Marín Marotto. Desde USD 32.000, servicios completos, financiación disponible y escrituración inmediata. Consultas directas con Victor.";

const whatsappUrl = "https://wa.me/5493571541588?text=Hola%20Victor%2C%20quiero%20consultar%20por%20los%20lotes%20en%20Rio%20Tercero";

const images = [
  { src: '/victor/lotes-rio-tercero/mapa-1.png', alt: 'Ubicación en mapa' },
  { src: '/victor/lotes-rio-tercero/terreno-1.jpeg', alt: 'Lote en Río Tercero - Vista 1' },
  { src: '/victor/lotes-rio-tercero/terreno-2.jpeg', alt: 'Lote en Río Tercero - Vista 2' },
  { src: '/victor/lotes-rio-tercero/terreno-3.jpeg', alt: 'Lote en Río Tercero - Vista 3' },
  { src: '/victor/lotes-rio-tercero/terreno-4.jpeg', alt: 'Lote en Río Tercero - Vista 4' },
  { src: '/victor/lotes-rio-tercero/terreno-5.jpeg', alt: 'Lote en Río Tercero - Vista 5' },
  { src: '/victor/lotes-rio-tercero/plano-1.png', alt: 'Plano de los lotes' }
];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <!-- Open Graph -->
  <meta property="og:title" content="Lotes en Río Tercero desde USD 32.000">
  <meta property="og:description" content="Barrio Marín Marotto · Servicios completos · Financiación disponible · Dueño directo">
  <meta property="og:image" content="https://www.wolfim.com/victor/lotes-rio-tercero/mapa-1.png">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.wolfim.com/victor/lotes-rio-tercero">

  <link rel="icon" type="image/svg+xml" href="/favicom.svg" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>
<body class="font-sans antialiased bg-gray-900 text-gray-900 h-[100dvh] overflow-hidden">
  
  <div class="flex flex-col md:flex-row h-[100dvh] w-full bg-white overflow-hidden max-w-[1400px] mx-auto relative shadow-2xl">
    
    <!-- LEFT / TOP: Image Gallery Area -->
    <div class="relative flex-1 flex flex-col bg-gray-900 overflow-hidden h-[42dvh] md:h-full shrink-0">
      
      <!-- Badge superior (Dueño directo) over the main image on mobile -->
      <div class="absolute top-3 left-3 z-10 md:hidden">
        <div class="inline-flex items-center gap-1 px-2.5 py-1 bg-green-600/90 backdrop-blur-sm text-white text-[10px] font-bold uppercase tracking-wider rounded-md shadow-lg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Dueño directo
        </div>
      </div>

      <!-- Main Image Viewer -->
      <div 
        class="flex-1 relative flex items-center justify-center overflow-hidden cursor-pointer group bg-[#0a0a0a]"
        id="main-viewer"
      >
        <img 
          src={images[0].src} 
          alt={images[0].alt}
          id="main-image"
          class="w-full h-full object-cover md:object-contain transition-transform duration-500 group-hover:scale-[1.02]"
          onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100%\' height=\'100%\' fill=\'%23e5e7eb\'><rect width=\'100%\' height=\'100%\'/><text x=\'50%\' y=\'50%\' font-family=\'sans-serif\' font-size=\'20\' text-anchor=\'middle\' fill=\'%239ca3af\'>Imagen no encontrada</text></svg>'"
        />
        <!-- Enlarge Hint -->
        <div class="absolute top-3 right-3 md:top-4 md:right-4 bg-black/60 text-white p-2 rounded-full backdrop-blur-md opacity-80 group-hover:opacity-100 transition-opacity flex items-center justify-center shadow-lg pointer-events-none">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        </div>
      </div>

      <!-- Thumbnail Strip -->
      <div class="h-[75px] md:h-[110px] bg-gray-950 flex gap-1.5 md:gap-2 p-2 md:p-3 overflow-x-auto items-center justify-start snap-x shrink-0" style="scrollbar-width: none;">
        {images.map((img, idx) => (
          <button 
            data-index={idx}
            data-src={img.src}
            data-alt={img.alt}
            class={`thumb-btn relative h-full shrink-0 aspect-[4/3] rounded-md overflow-hidden snap-center transition-all duration-300 ${idx === 0 ? 'ring-2 ring-white opacity-100 shadow-[0_0_15px_rgba(255,255,255,0.3)]' : 'opacity-40 hover:opacity-100'}`}
          >
            <img src={img.src} alt={img.alt} class="w-full h-full object-cover" onerror="this.style.display='none'" />
          </button>
        ))}
      </div>
    </div>

    <!-- RIGHT / BOTTOM: Info & CTA Area -->
    <div class="w-full md:w-[420px] lg:w-[480px] bg-white h-[58dvh] md:h-full flex flex-col shrink-0 relative shadow-[-10px_0_20px_rgba(0,0,0,0.1)]">
      
      <!-- Content area -->
      <div class="flex-1 p-3 md:p-6 flex flex-col justify-center md:pb-6 relative z-10 h-full overflow-hidden">
        
        <div class="mb-2 md:mb-5">
          <div class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-50 text-green-700 text-xs font-bold uppercase tracking-wider rounded-lg border border-green-200 mb-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Dueño directo
          </div>
          
          <h1 class="text-[20px] md:text-3xl font-extrabold text-gray-900 leading-tight mb-0.5 tracking-tight">
            Lotes en Río Tercero
          </h1>
          <h2 class="text-[13px] md:text-[15px] font-semibold text-blue-600 mb-1.5 md:mb-3">
            Barrio Marín Marotto · Desde USD 32.000
          </h2>
          <p class="text-[11px] md:text-[14px] font-normal text-gray-600 leading-snug hidden md:block mb-3">
            Lotes urbanos en zona Av. General Savio / Mendoza, con infraestructura completa y escrituración inmediata.
          </p>
        </div>

        <!-- Cards principales -->
        <div class="grid grid-cols-2 md:flex md:flex-col gap-2 md:gap-3 mb-3 md:mb-5">
          <div class="bg-gray-50 p-2.5 md:p-4 rounded-xl border border-gray-100 flex flex-col justify-center items-center md:flex-row md:justify-between text-center md:text-left">
            <div>
              <p class="text-[9.5px] md:text-xs text-gray-500 font-semibold uppercase tracking-wider mb-0.5">11 lotes de 12 x 30 m</p>
              <p class="font-black text-gray-900 text-sm md:text-lg">USD 32.000 <span class="text-[10px] md:text-xs font-medium text-gray-500">c/u</span></p>
            </div>
            <div class="hidden md:flex w-8 h-8 rounded-full bg-blue-50 items-center justify-center text-blue-600">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M3 9h18M9 21V9"/></svg>
            </div>
          </div>
          <div class="bg-gray-50 p-2.5 md:p-4 rounded-xl border border-gray-100 flex flex-col justify-center items-center md:flex-row md:justify-between text-center md:text-left">
            <div>
              <p class="text-[9.5px] md:text-xs text-gray-500 font-semibold uppercase tracking-wider mb-0.5">2 lotes de 24 x 30 m</p>
              <p class="font-black text-gray-900 text-sm md:text-lg">USD 64.000 <span class="text-[10px] md:text-xs font-medium text-gray-500">c/u</span></p>
            </div>
            <div class="hidden md:flex w-8 h-8 rounded-full bg-blue-50 items-center justify-center text-blue-600">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M3 9h18M9 21V9"/></svg>
            </div>
          </div>
        </div>

        <!-- Servicios -->
        <div class="mb-3 md:mb-5 bg-white md:bg-gray-50 md:p-4 rounded-lg md:border border-gray-100">
          <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1 hidden md:block">Servicios incluidos</p>
          <p class="text-[11px] md:hidden text-gray-700 font-medium leading-tight">
            <span class="font-bold text-gray-900">Servicios:</span> Asfalto, cordón cuneta, luz, agua, gas natural, cloacas.
          </p>
          <div class="hidden md:grid grid-cols-2 gap-y-2 gap-x-2 text-[12px] text-gray-700 font-medium">
            <div class="flex items-center gap-1.5"><div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div> Asfalto</div>
            <div class="flex items-center gap-1.5"><div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div> Cordón cuneta</div>
            <div class="flex items-center gap-1.5"><div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div> Luz</div>
            <div class="flex items-center gap-1.5"><div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div> Agua</div>
            <div class="flex items-center gap-1.5"><div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div> Gas natural</div>
            <div class="flex items-center gap-1.5"><div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div> Cloacas</div>
          </div>
        </div>

        <!-- Confianza -->
        <div class="mb-2 md:mb-6">
          <ul class="space-y-1.5 md:space-y-2.5 text-[11px] md:text-[13px] text-gray-800 font-medium">
            <li class="flex items-start gap-2">
              <span class="flex items-center justify-center w-3.5 h-3.5 md:w-4 md:h-4 mt-0.5 rounded-full bg-blue-100 text-blue-700 text-[9px] shrink-0 font-bold">✓</span> 
              Trato directo con dueño y escrituración inmediata
            </li>
            <li class="flex items-start gap-2">
              <span class="flex items-center justify-center w-3.5 h-3.5 md:w-4 md:h-4 mt-0.5 rounded-full bg-blue-100 text-blue-700 text-[9px] shrink-0 font-bold">✓</span> 
              Posibilidad de financiación disponible
            </li>
          </ul>
        </div>
        
        <!-- Push button to bottom -->
        <div class="mt-auto"></div>

      </div>
      
      <!-- Fixed Bottom CTA Area (Shared for desktop and mobile) -->
      <div class="p-3 md:p-6 bg-white border-t border-gray-100 shrink-0 relative z-20">
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="whatsapp-victor-lotes-rio-tercero"
          data-campaign="victor-lotes-rio-tercero"
          id="whatsapp-link-desktop"
          class="w-full bg-[#25D366] hover:bg-[#20b858] text-white text-center font-bold py-3 md:py-4 px-6 rounded-xl md:rounded-2xl shadow-[0_4px_14px_0_rgba(37,211,102,0.3)] transition-transform transform active:scale-[0.98] flex items-center justify-center text-[15px] md:text-lg gap-2"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          Consultar por WhatsApp
        </a>
        <div class="text-center text-[10px] md:text-[12px] text-gray-500 font-medium leading-tight mt-1.5">
          <p>Consultas directas con Victor: <span class="font-bold text-gray-800">WhatsApp +54 9 3571 54-1588</span></p>
        </div>
      </div>
    </div>

    <!-- Fullscreen Zoom Modal (Hidden by default) -->
    <div id="zoom-modal" class="fixed inset-0 z-[100] bg-black/95 flex-col duration-200 hidden">
      <!-- Top bar -->
      <div class="flex justify-between items-center p-4 md:p-6 bg-gradient-to-b from-black/80 to-transparent">
        <span class="text-white/70 text-sm font-medium" id="zoom-counter">1 / {images.length}</span>
        <button 
          id="close-zoom"
          class="text-white hover:text-gray-300 p-2 bg-white/10 hover:bg-white/20 rounded-full transition-colors"
        >
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      
      <!-- Big Image Viewer -->
      <div class="flex-1 flex items-center justify-center overflow-hidden p-0 md:p-8" id="zoom-bg">
        <img 
          src={images[0].src} 
          alt={images[0].alt}
          id="zoom-image"
          class="w-full h-full object-contain select-none shadow-2xl"
        />
      </div>

      <!-- Modal Thumbnails -->
      <div class="h-24 md:h-32 flex justify-center gap-2 p-4 bg-gradient-to-t from-black/80 to-transparent overflow-x-auto shrink-0 pb-6" style="scrollbar-width: none;">
        {images.map((img, idx) => (
          <button 
            data-index={idx}
            data-src={img.src}
            data-alt={img.alt}
            class={`modal-thumb-btn h-full shrink-0 aspect-[4/3] rounded-lg overflow-hidden transition-all duration-300 ${idx === 0 ? 'ring-2 ring-white opacity-100 scale-105' : 'opacity-50 hover:opacity-100'}`}
          >
            <img src={img.src} alt={img.alt} class="w-full h-full object-cover" onerror="this.style.display='none'" />
          </button>
        ))}
      </div>
    </div>

  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let activeIndex = 0;
      const thumbBtns = document.querySelectorAll('.thumb-btn');
      const totalImages = thumbBtns.length;
      
      const mainImage = document.getElementById('main-image');
      const zoomImage = document.getElementById('zoom-image');
      const mainViewer = document.getElementById('main-viewer');
      const zoomModal = document.getElementById('zoom-modal');
      const closeZoom = document.getElementById('close-zoom');
      const zoomBg = document.getElementById('zoom-bg');
      const zoomCounter = document.getElementById('zoom-counter');

      const modalThumbBtns = document.querySelectorAll('.modal-thumb-btn');

      function updateImages(index, src, alt) {
        activeIndex = index;
        mainImage.src = src;
        mainImage.alt = alt;
        zoomImage.src = src;
        zoomImage.alt = alt;
        zoomCounter.textContent = `${index + 1} / ${totalImages}`;

        // Update active state on main thumbs
        thumbBtns.forEach((btn, idx) => {
          if (idx === index) {
            btn.classList.add('ring-2', 'ring-blue-600', 'md:ring-white', 'opacity-100', 'md:shadow-[0_0_15px_rgba(255,255,255,0.3)]');
            btn.classList.remove('opacity-60', 'md:opacity-40', 'ring-1', 'ring-gray-200', 'md:ring-0');
          } else {
            btn.classList.remove('ring-2', 'ring-blue-600', 'md:ring-white', 'opacity-100', 'md:shadow-[0_0_15px_rgba(255,255,255,0.3)]');
            btn.classList.add('opacity-60', 'md:opacity-40', 'ring-1', 'ring-gray-200', 'md:ring-0');
          }
        });

        // Update active state on modal thumbs
        modalThumbBtns.forEach((btn, idx) => {
          if (idx === index) {
            btn.classList.add('ring-2', 'ring-white', 'opacity-100', 'scale-105');
            btn.classList.remove('opacity-50');
          } else {
            btn.classList.remove('ring-2', 'ring-white', 'opacity-100', 'scale-105');
            btn.classList.add('opacity-50');
          }
        });
      }

      thumbBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-index'));
          const src = btn.getAttribute('data-src');
          const alt = btn.getAttribute('data-alt');
          updateImages(index, src, alt);
        });
      });

      modalThumbBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-index'));
          const src = btn.getAttribute('data-src');
          const alt = btn.getAttribute('data-alt');
          updateImages(index, src, alt);
        });
      });

      mainViewer.addEventListener('click', () => {
        zoomModal.classList.remove('hidden');
        zoomModal.classList.add('flex');
      });

      closeZoom.addEventListener('click', () => {
        zoomModal.classList.add('hidden');
        zoomModal.classList.remove('flex');
      });

      zoomBg.addEventListener('click', (e) => {
        if (e.target === zoomBg || e.target === zoomImage.parentElement) {
          zoomModal.classList.add('hidden');
          zoomModal.classList.remove('flex');
        }
      });

      const trackWhatsappClick = () => {
        if (typeof window !== 'undefined' && window.gtag) {
          window.gtag('event', 'whatsapp_click_victor_lotes_rio_tercero', { 
            campaign: 'victor-lotes-rio-tercero',
            cta: 'whatsapp-victor-lotes-rio-tercero'
          });
        }
      };

      const desktopLink = document.getElementById('whatsapp-link-desktop');
      const mobileLink = document.getElementById('whatsapp-link-mobile');
      
      if(desktopLink) desktopLink.addEventListener('click', trackWhatsappClick);
      if(mobileLink) mobileLink.addEventListener('click', trackWhatsappClick);
    });
  </script>
</body>
</html>
