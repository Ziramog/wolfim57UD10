---
import Layout from '../layouts/Layout.astro';
import HeroV5 from '../components/HeroV5.astro';
import BusinessOverview from '../components/BusinessOverview.astro';
import KineticDirection from '../components/KineticDirection.astro';
import ProjectShowcaseV7 from '../components/ProjectShowcaseV7.astro';
import MethodContactV7 from '../components/MethodContactV7.astro';
import MethodStackV9 from '../components/MethodStackV9.astro';
import Transformacion360V8 from '../components/Transformacion360V8.astro';
---

<Layout title="WOLFIM / 57UD10 | Estudio de negocios digitales" description="Estrategia, diseño y tecnología para mejorar cómo tu negocio se presenta, vende y opera. Soluciones B2B, B2C y multicanal.">

  <!-- ═══════════════ AMBIENT ELEMENTS ═══════════════ -->
  <div id="cinematic-bg" aria-hidden="true"></div>
  <div class="film-grain" aria-hidden="true"></div>

  <!-- ═══════════════ NAVIGATION ═══════════════ -->
  <nav id="nav-main" class="nav nav--v6">
    <div class="nav__inner">
      <a href="#hero" class="nav__logo" id="nav-logo">
        <img src="/wolfim_logos/logo_wolfim_57UD10.svg" alt="WOLFIM / 57UD10" class="nav__logo-img" width="4188" height="738">
      </a>
      <div class="nav__links" id="nav-links">
        <a href="#soluciones" class="nav__link" data-i18n="nav.solutions">Soluciones</a>
        <a href="#transformacion-360" class="nav__link" data-i18n="nav.digital360">360°</a>
        <a href="#modelos" class="nav__link" data-i18n="nav.models">Tu negocio</a>
        <a href="#projects" class="nav__link" data-i18n="nav.projects">Proyectos</a>
        <a href="#process" class="nav__link" data-i18n="nav.method">Método</a>
        <a href="#contact" class="nav__link" data-i18n="nav.contact">Contacto</a>
      </div>
      <div class="nav__meta">
        <a href="https://wa.me/5493513157202?text=Hola%20WOLFIM%2C%20quiero%20contarles%20un%20desaf%C3%ADo%20de%20mi%20empresa." class="nav__brief-cta" data-cta="nav_v6_conversation" target="_blank" rel="noopener noreferrer" data-i18n="nav.talk">Hablemos</a>
        <button class="lang-toggle" id="lang-toggle" title="Cambiar idioma">
          <span class="lang-toggle__option" data-lang="en">EN</span>
          <span class="lang-toggle__divider">/</span>
          <span class="lang-toggle__option lang-toggle__option--active" data-lang="es">ES</span>
        </button>
        <button class="nav__menu-btn" id="nav-menu-btn" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
    <div class="nav__line"></div>
  </nav>

  <!-- Mobile overlay -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu__close" id="mobile-menu-close" aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <div class="mobile-menu__inner">
      <div class="mobile-menu__links">
        <a href="#soluciones" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.solutions">Soluciones</span></a>
        <a href="#transformacion-360" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.digital360">360°</span></a>
        <a href="#modelos" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.models">Tu negocio</span></a>
        <a href="#projects" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.projects">Proyectos</span></a>
        <a href="#process" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.method">Método</span></a>
        <a href="#contact" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.contact">Contacto</span></a>
        <a href="https://wa.me/5493513157202?text=Hola%20WOLFIM%2C%20quiero%20contarles%20un%20desaf%C3%ADo%20de%20mi%20empresa." class="mobile-menu__link" data-cta="mobile_v6_conversation" target="_blank" rel="noopener noreferrer"><span class="menu-link-prefix">/</span><span data-i18n="nav.talk">Hablemos</span></a>
      </div>
    </div>
  </div>

  <!-- HERO V6.2 — dirección cinética oficial -->
  <HeroV5 />

  <main id="main-content">
  <!-- V6: problemas, capacidades y tres recorridos comerciales -->
  <BusinessOverview />
  <KineticDirection />

  <!-- WOLFIM V7 · Presentación de proyectos sin claims no verificados -->
  <ProjectShowcaseV7 />

  <Transformacion360V8 />

  <!-- WOLFIM V9 · tarjetas numeradas superpuestas, adaptadas del sitio público -->
  <MethodStackV9 />
  </main>

  <!-- WOLFIM V7 · contacto comercial -->
  <MethodContactV7 />

  <!-- WhatsApp Sticky Button -->
  <a href="https://wa.me/5493513157202?text=Hola%20WOLFIM%2C%20me%20gustar%C3%ADa%20conversar%20sobre%20mi%20negocio" data-cta="sticky" class="whatsapp-sticky" target="_blank" rel="noopener noreferrer" aria-label="Chatear por WhatsApp">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
      <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
    </svg>
  </a>

  <!-- Main Script -->
  <script>import "../scripts/script.js";</script>


<script>
  import { trackEvent } from '../lib/analytics';
  import { captureUTMs } from '../lib/utm';
  import { initWhatsAppTracking } from '../lib/whatsapp-tracking';

  // 1. Atribución (UTMs + gclid/fbclid/msclkid)
  captureUTMs();

  // 2. Único tracker de WhatsApp: un listener delegado para todos los links
  //    wa.me de la página (antes había dos listeners y el `component` salía mal).
  initWhatsAppTracking({ track: trackEvent });

  // 3. Eventos de navegación / CTA
  document.addEventListener('DOMContentLoaded', () => {
    // V6: CTA genérico al contacto comercial real y acceso a soluciones.
    const heroChallenge = document.querySelector('[data-v6-cta="challenge"]');
    if (heroChallenge) {
      heroChallenge.addEventListener('click', () => trackEvent('contact_cta_click', { component: 'home_hero_v6', route: 'whatsapp' }));
    }

    const heroSolutions = document.querySelector('[data-v6-cta="solutions"]');
    if (heroSolutions) {
      heroSolutions.addEventListener('click', () => trackEvent('click_service', { component: 'home_hero_v6', service_name: 'Soluciones' }));
    }

    // CTA del bloque de contacto → /diagnostico
    const diagnosisCta = document.getElementById('contact-cta-diagnostico');
    if (diagnosisCta) {
      diagnosisCta.addEventListener('click', () => trackEvent('click_cta_diagnostico', { component: 'home_contact' }));
    }
  });
</script>
</Layout>



