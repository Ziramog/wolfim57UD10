---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dise�o web premium y cat�logos digitales | Wolfim Studio">

  <!-- ═══════════════ AMBIENT ELEMENTS ═══════════════ -->
  <div id="cinematic-bg" aria-hidden="true"></div>
  <div class="film-grain" aria-hidden="true"></div>

  <!-- ═══════════════ NAVIGATION ═══════════════ -->
  <nav id="nav-main" class="nav">
    <div class="nav__inner">
      <a href="#hero" class="nav__logo" id="nav-logo">
        <img src="/wolfim_logos/logo_wolfim_57UD10.svg" alt="Wolfim 57UD10" class="nav__logo-img" width="120" height="35">
      </a>
      <div class="nav__links" id="nav-links">
        <a href="#projects" class="nav__link" data-i18n="nav.projects">Trabajos</a>
        <a href="#capabilities" class="nav__link" data-i18n="nav.capabilities">Servicios</a>
        <a href="#pricing" class="nav__link" data-i18n="nav.pricing">Precios</a>
        <a href="#process" class="nav__link" data-i18n="nav.process">Proceso</a>
        <a href="#contact" class="nav__link" data-i18n="nav.contact">Contacto</a>
      </div>
      <div class="nav__meta">
        <button class="lang-toggle" id="lang-toggle" aria-label="Toggle language">
          <span class="lang-toggle__option" data-lang="en">EN</span>
          <span class="lang-toggle__divider">/</span>
          <span class="lang-toggle__option lang-toggle__option--active" data-lang="es">ES</span>
        </button>
        <span class="nav__time" id="nav-time"></span>
        <button class="nav__menu-btn" id="nav-menu-btn" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
    <div class="nav__line"></div>
  </nav>

  <!-- Mobile overlay -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu__close" id="mobile-menu-close" aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <div class="mobile-menu__inner">
      <div class="mobile-menu__links">
        <a href="#projects" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.projects">Trabajos</span></a>
        <a href="#capabilities" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.capabilities">Servicios</span></a>
        <a href="#pricing" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.pricing">Precios</span></a>
        <a href="#process" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span data-i18n="nav.process">Proceso</span></a>
      </div>
    </div>
  </div>

  <!-- ═══════════════ HERO ═══════════════ -->
  <header id="hero" class="hero">
    <div class="hero__grid-lines" id="hero-grid" aria-hidden="true">
      <!-- Horizontal lines for mobile -->
      <div class="hero__hline hline-1"></div>
      <div class="hero__hline hline-2"></div>
      <div class="hero__hline hline-3"></div>

      <div class="hero__scan-line"></div>
    </div>

    <div class="hero__content">
      <div class="hero__left">

        <h1 class="hero__statement" data-animate="fade-up" data-i18n="hero.statement">Diseño web premium para catálogos y sitios que venden mejor.</h1>
        <p class="hero__subtext" data-animate="fade-up" data-i18n="hero.subtext">Diseño web a medida, rediseño de sitios, catálogos digitales y producción visual con IA para marcas, propiedades, productos y servicios.</p>
        <div class="hero__tags" data-animate="fade-up" data-i18n="hero.tags">
          <span class="hero__tag">Web</span>
          <span class="hero__tag">Catálogo</span>
          <span class="hero__tag">Reconstrucción</span>
          <span class="hero__tag">IA</span>
          <span class="hero__tag">SEO</span>
        </div>
        <div class="hero__cta-wrapper" data-animate="fade-up">
          <a href="https://wa.me/5491173858454?text=Hola%2C%20quisiera%20consultar%20por%20un%20proyecto" class="hero__cta hero__cta--primary" target="_blank" rel="noopener noreferrer" data-i18n="hero.cta_primary">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" style="margin-right: 0.75rem;">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.405-.883-.733-1.48-1.638-1.653-1.935-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Empezar proyecto
          </a>
          <a href="#pricing" class="hero__cta hero__cta--secondary" data-i18n="hero.cta_secondary">Ver trabajos</a>
        </div>
      </div>
      <div class="hero__video-frame" data-animate="fade-up">
        <div class="hero__scene">
          <video class="hero__scene-video" autoplay loop muted playsinline preload="auto">
            <source src="herolast.mp4" type="video/mp4">
          </video>
        </div>
        <div class="hero__video-footer">
          <div class="hero__logo-stack">
            <img src="/wolfim_logos/logo_wolfim_sin57UD10.svg" alt="Wolfim" class="hero__logo-img" width="300" height="105">
            <div class="hero__logo-row">
              <span class="hero__logo-divider">/</span>
              <span class="hero__scramble" id="hero-scramble">57UD10</span>
            </div>
          </div>
        </div>
      </div>
      <div class="hero__scroll" data-animate="fade-up">
        <span class="hero__scroll-cipher" id="scroll-cipher" data-i18n="hero.scroll">Desplazar</span>
      </div>
      <div class="hero__footer">
        <span class="hero__location" data-i18n-html="hero.location">Buenos Aires <span class="hero__location-dot">●</span> Servicio remoto para clientes de todo el mundo</span>
      </div>
      <div class="hero__logo-fixed">
        <img src="/wolfim_logos/logo_wolfim_sin57UD10.svg" alt="Wolfim" class="hero__logo-img" width="80" height="28">
        <div class="hero__logo-row">
          <span class="hero__logo-divider">/</span>
          <span class="hero__scramble" id="hero-scramble-mobile">57UD10</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══════════════ SELECTED PROJECTS ══════════════ -->
  <section id="projects" class="section projects">
    <div class="section__header" data-animate="fade-up">
      <span class="section__number">01</span>
      <h2 class="section__title" data-i18n-html="projects.title">Trabajos<br>recientes</h2>
      <p class="section__subtitle" data-i18n="projects.subtitle">Sitios web y sistemas digitales construidos para rendir</p>
    </div>
    <div class="section__line"></div>
    <div class="projects__grid">

      <article class="project" data-animate="fade-up">
        <div class="project__image">
          <video class="project__image-inner project__video" autoplay loop muted playsinline preload="auto" aria-label="Video de presentación del sitio web inmersivo para Silvia Roggero de Roma, Negocios Inmobiliarios">
            <source src="roggeroyroma_hero2.mp4" type="video/mp4">
          </video>
        </div>
        <div class="project__info">
          <span class="project__number">001</span>
          <h3 class="project__title" data-i18n-html="projects.p1.title">Silvia Roggero<br>de Roma</h3>
          <div class="project__meta">
          <span class="project__tag" data-i18n="projects.p1.tag1">Reconstrucción Web Inmersiva</span>
          <span class="project__tag" data-i18n="projects.p1.tag2">Real Estate</span>
          </div>
          <p class="project__desc" data-i18n="projects.p1.desc">Rediseño completo para una inmobiliaria con presencia previa. Nuevo sitio desde cero con estética premium, hero en video, catálogo de propiedades, mapas interactivos, reseñas y herramientas comerciales para elevar la percepción de marca y ordenar las consultas.</p>
          <a href="#" class="project__link" target="_blank" rel="noopener noreferrer"><span data-i18n="projects.visit">Visitar sitio en vivo ↗</span></a>
        </div>
      </article>

      <article class="project project--reverse" data-animate="fade-up">
        <div class="project__image">
          <video class="project__image-inner project__video" autoplay loop muted playsinline preload="auto" aria-label="Video de presentación de la plataforma digital S&P Cars para agencia de autos premium">
            <source src="SPCars.mp4" type="video/mp4">
          </video>
        </div>
        <div class="project__info">
          <span class="project__number">002</span>
          <h3 class="project__title" data-i18n-html="projects.p2.title">S&amp;P<br>Cars</h3>
          <div class="project__meta">
            <span class="project__tag" data-i18n="projects.p2.tag1">Plataforma automotriz</span>
            <span class="project__tag" data-i18n="projects.p2.tag2">IA y automatización</span>
          </div>
          <p class="project__desc" data-i18n="projects.p2.desc">Plataforma digital de alto rendimiento para agencia de autos premium nuevos y usados. Descripciones de vehículos potenciadas por IA, arquitectura SEO avanzada, comparativas lado a lado y presupuestos automatizados para convertir tráfico de búsqueda en ventas.</p>
          <a href="#" class="project__link" target="_blank" rel="noopener noreferrer"><span data-i18n="projects.visit">Visitar sitio en vivo ↗</span></a>
        </div>
      </article>

      <article class="project" data-animate="fade-up">
        <div class="project__image">
          <video class="project__image-inner project__video" autoplay loop muted playsinline preload="auto" aria-label="Video de presentación del catálogo comercial digital para Construvial S.A.">
            <source src="construvial-2.mp4" type="video/mp4">
          </video>
        </div>
        <div class="project__info">
          <span class="project__number">003</span>
          <h3 class="project__title" data-i18n-html="projects.p3.title">Construvial<br>S.A.</h3>
          <div class="project__meta">
            <span class="project__tag" data-i18n="projects.p3.tag1">Catálogo Comercial Digital</span>
            <span class="project__tag" data-i18n="projects.p3.tag2">Construcción & Maquinaria</span>
          </div>
          <p class="project__desc" data-i18n="projects.p3.desc">Catálogo comercial para empresa de construcción y maquinaria. Organización de servicios, equipos, categorías, imágenes y datos técnicos en una pieza visual clara, profesional y lista para compartir por WhatsApp, email o PDF.</p>
          <a href="#" class="project__link" target="_blank" rel="noopener noreferrer"><span data-i18n="projects.visit">Visitar sitio en vivo ↗</span></a>
        </div>
      </article>

      <article class="project project--reverse" data-animate="fade-up">
        <div class="project__image">
          <video class="project__image-inner project__video" autoplay loop muted playsinline preload="auto" aria-label="Video de presentación de Korantis - búsqueda de restaurantes y cafeterías con IA">
            <source src="Korantis_web_UI_showcase.mp4" type="video/mp4">
          </video>
        </div>
        <div class="project__info">
          <span class="project__number">004</span>
          <h3 class="project__title" data-i18n-html="projects.p4.title">KORANTIS<br>.COM</h3>
          <div class="project__meta">
            <span class="project__tag" data-i18n="projects.p4.tag1">Buscador con IA</span>
            <span class="project__tag" data-i18n="projects.p4.tag2">Plataforma web</span>
          </div>
          <p class="project__desc" data-i18n="projects.p4.desc">Motor de búsqueda de restaurantes y cafeterías con recomendaciones conversacionales potenciadas por IA. Filtros inteligentes, sugerencias personalizadas e interfaz precisa para encontrar el lugar ideal antes de terminar de escribir.</p>
          <a href="#" class="project__link" target="_blank" rel="noopener noreferrer"><span data-i18n="projects.visit">Visitar sitio en vivo ↗</span></a>
        </div>
      </article>

    </div>
  </section>

  <!-- ═══════════════ PRICING ═══════════════ -->
  <section id="pricing" class="section pricing-section">
    <div class="section__header" data-animate="fade-up">
      <h2 class="section__title" data-i18n-html="pricing.title">Precios claros.<br>Sin sorpresas.</h2>
      <p class="section__subtitle" data-i18n="pricing.subtitle">Precios base para estructuras estándar o adaptables.</p>
    </div>
    <div class="section__line"></div>

    <div class="pricing__grid">
      <!-- Plan 1 -->
      <div class="pricing-card" data-animate="fade-up">
        <div class="pricing-card__header">
          <span class="pricing-card__tag" data-i18n="pricing.p1.tag">Ideal para empezar</span>
          <h3 class="pricing-card__title" data-i18n="pricing.p1.title">Landing</h3>
          <div class="pricing-card__price">
            <span class="pricing-card__amount">$200</span>
            <span class="pricing-card__period" data-i18n="pricing.setup">USD setup</span>
          </div>
          <div class="pricing-card__monthly">
            <span class="pricing-card__plus">+</span>
            <span class="pricing-card__amount-small">$25</span>
            <span class="pricing-card__period" data-i18n="pricing.monthly">USD/mes</span>
          </div>
          <p class="pricing-card__terms" data-i18n="pricing.terms">50% por adelantado para comenzar</p>
        </div>
        <ul class="pricing-card__features">
          <li data-i18n="pricing.p1.f1">Diseño personalizado</li>
          <li data-i18n="pricing.p1.f2">1 página optimizada</li>
          <li data-i18n="pricing.p1.f3">Secciones esenciales del negocio</li>
          <li data-i18n="pricing.p1.f4">WhatsApp + formulario</li>
          <li data-i18n="pricing.p1.f5">SEO básico</li>
          <li data-i18n="pricing.p1.f6">Hosting + SSL incluido</li>
          <li data-i18n="pricing.p1.f7">Entrega en 2 semanas</li>
        </ul>
        <p class="pricing-card__note" data-i18n="pricing.p1.note">Ideal para servicios, profesionales, marcas personales y negocios que necesitan presencia simple.</p>
      </div>

      <!-- Plan 2 -->
      <div class="pricing-card pricing-card--featured" data-animate="fade-up">
        <div class="pricing-card__header">
          <span class="pricing-card__tag" data-i18n="pricing.p2.tag">El más elegido</span>
          <h3 class="pricing-card__title" data-i18n="pricing.p2.title">Profesional</h3>
          <div class="pricing-card__price">
            <span class="pricing-card__amount">$300</span>
            <span class="pricing-card__period" data-i18n="pricing.setup">USD setup</span>
          </div>
          <div class="pricing-card__monthly">
            <span class="pricing-card__plus">+</span>
            <span class="pricing-card__amount-small">$29</span>
            <span class="pricing-card__period" data-i18n="pricing.monthly">USD/mes</span>
          </div>
          <p class="pricing-card__terms" data-i18n="pricing.terms">50% por adelantado para comenzar</p>
        </div>
        <ul class="pricing-card__features">
          <li data-i18n="pricing.p2.f1">Diseño personalizado</li>
          <li data-i18n="pricing.p2.f2">Hasta 5 páginas</li>
          <li data-i18n="pricing.p2.f3">Servicios, empresa, trabajos y contacto</li>
          <li data-i18n="pricing.p2.f4">Galería de fotos</li>
          <li data-i18n="pricing.p2.f5">SEO optimizado</li>
          <li data-i18n="pricing.p2.f6">Formulario + WhatsApp</li>
          <li data-i18n="pricing.p2.f7">Hosting + SSL incluido</li>
          <li data-i18n="pricing.p2.f8">Entrega en 2-3 semanas</li>
        </ul>
        <p class="pricing-card__note" data-i18n="pricing.p2.note">Ideal para empresas, constructoras, estudios, clínicas, industrias y negocios con más contenido institucional.</p>
      </div>

      <!-- Plan 3 -->
      <div class="pricing-card" data-animate="fade-up">
        <div class="pricing-card__header">
          <span class="pricing-card__tag" data-i18n="pricing.p3.tag">Para productos y propiedades</span>
          <h3 class="pricing-card__title" data-i18n="pricing.p3.title">Catálogo</h3>
          <div class="pricing-card__price">
            <span class="pricing-card__amount">Desde $450</span>
            <span class="pricing-card__period" data-i18n="pricing.setup">USD setup</span>
          </div>
          <div class="pricing-card__monthly">
            <span class="pricing-card__plus">+</span>
            <span class="pricing-card__amount-small">$39</span>
            <span class="pricing-card__period" data-i18n="pricing.monthly">USD/mes</span>
          </div>
          <p class="pricing-card__terms" data-i18n="pricing.terms">50% por adelantado para comenzar</p>
        </div>
        <ul class="pricing-card__features">
          <li data-i18n="pricing.p3.f1">Diseño personalizado</li>
          <li data-i18n="pricing.p3.f2">Web catálogo adaptable</li>
          <li data-i18n="pricing.p3.f3">Fichas individuales</li>
          <li data-i18n="pricing.p3.f4">Filtros y buscador</li>
          <li data-i18n="pricing.p3.f5">WhatsApp por ítem</li>
          <li data-i18n="pricing.p3.f6">Panel simple de publicación</li>
          <li data-i18n="pricing.p3.f7">SEO por ficha</li>
          <li data-i18n="pricing.p3.f8">Hosting + SSL incluido</li>
          <li data-i18n="pricing.p3.f9">Entrega en 3-4 semanas</li>
        </ul>
        <p class="pricing-card__note" data-i18n="pricing.p3.note">Ideal para inmobiliarias, agencias de autos, loteos, maquinaria, repuestos y negocios que necesitan mostrar lo que venden en una web propia.</p>
        <p class="pricing-card__disclaimer" data-i18n="pricing.p3.disclaimer">El precio base aplica sobre una estructura replicable. Diseños, filtros, flujos o funcionalidades diferentes se cotizan aparte.</p>
      </div>

      <!-- Plan 4 -->
      <div class="pricing-card" data-animate="fade-up">
        <div class="pricing-card__header">
          <span class="pricing-card__tag" data-i18n="pricing.p4.tag">Tienda completa</span>
          <h3 class="pricing-card__title" data-i18n="pricing.p4.title">Ecommerce</h3>
          <div class="pricing-card__price">
            <span class="pricing-card__amount">Desde $450</span>
            <span class="pricing-card__period" data-i18n="pricing.setup">USD setup</span>
          </div>
          <div class="pricing-card__monthly">
            <span class="pricing-card__plus">+</span>
            <span class="pricing-card__amount-small">$59</span>
            <span class="pricing-card__period" data-i18n="pricing.monthly">USD/mes</span>
          </div>
          <p class="pricing-card__terms" data-i18n="pricing.terms">50% por adelantado para comenzar</p>
        </div>
        <ul class="pricing-card__features">
          <li data-i18n="pricing.p4.f1">Diseño personalizado</li>
          <li data-i18n="pricing.p4.f2">Tienda online completa</li>
          <li data-i18n="pricing.p4.f3">Productos, carrito y checkout</li>
          <li data-i18n="pricing.p4.f4">Pasarela de pagos</li>
          <li data-i18n="pricing.p4.f5">Gestión de pedidos</li>
          <li data-i18n="pricing.p4.f6">SEO premium</li>
          <li data-i18n="pricing.p4.f7">Panel de admin completo</li>
          <li data-i18n="pricing.p4.f8">Hosting + SSL incluido</li>
          <li data-i18n="pricing.p4.f9">Entrega en 3-4 semanas</li>
        </ul>
        <p class="pricing-card__note" data-i18n="pricing.p4.note">Ideal para negocios que quieren vender online con pagos, carrito y gestión de pedidos.</p>
        <p class="pricing-card__disclaimer" data-i18n="pricing.p4.disclaimer">El alcance final depende de productos, medios de pago, envíos e integraciones.</p>
      </div>
    </div>

    <div class="pricing__cta" data-animate="fade-up">
      <a href="https://wa.me/5491173858454?text=Hola%2C%20estoy%20interesado%20en%20un%20sitio%20web" class="pricing__cta-button" target="_blank" rel="noopener noreferrer">
        <span data-i18n="pricing.cta_button">Consultar por WhatsApp</span>
      </a>
    </div>

    <div class="pricing__note" data-animate="fade-up">
      <p class="pricing__note-text" data-i18n="pricing.note">Reconstrucciones inmersivas, catálogos especiales, producción visual con IA o funcionalidades a medida se cotizan según alcance.</p>
    </div>
  </section>


  <!-- ═══════════════ FAQ ═══════════════ -->
  <section id="faq" class="section faq-section">
    <div class="section__header" data-animate="fade-up">
      <h2 class="section__title" data-i18n-html="faq.title">Preguntas<br>frecuentes</h2>
      <p class="section__subtitle" data-i18n="faq.subtitle">Resolvemos tus dudas antes de empezar</p>
    </div>
    <div class="section__line"></div>

    <div class="faq__list" data-animate="fade-up">
      <div class="faq-item">
        <button class="faq-item__question"><span data-i18n="faq.q1">¿Qué incluye el pago mensual?</span><span class="faq-item__icon">+</span></button>
        <div class="faq-item__answer"><p data-i18n="faq.a1">Incluye hosting premium, certificado SSL, copias de seguridad diarias, seguridad avanzada y soporte técnico.</p></div>
      </div>
      <div class="faq-item">
