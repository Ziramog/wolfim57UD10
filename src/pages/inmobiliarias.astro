---
import Layout from '../layouts/Layout.astro';

const title = "Caso Roggero & Roma — Portal inmobiliario con CRM | Wolfim Studio";
const description = "Caso real de portal inmobiliario premium con catálogo, fichas, WhatsApp por propiedad y panel privado para administrar propiedades desde el móvil.";
const ogImage = "https://wolfim.com/og-image.jpg";
const canonical = "https://wolfim.com/inmobiliarias";

const whatsappMessage = "Hola Wolfim, tengo una inmobiliaria y quiero ver cómo podría quedar un portal con catálogo, panel y WhatsApp por propiedad.";
const whatsappUrl = `https://wa.me/5493513157202?text=${encodeURIComponent(whatsappMessage)}`;

const publicFeatures = [
  'Home inmersiva con imagen o video',
  'Catálogo visual de propiedades',
  'Fichas individuales por inmueble',
  'Buscador, filtros y mapas',
  'Reseñas de Google integradas',
  'WhatsApp por propiedad',
  'SEO por ficha y ubicación',
];

const crmFeatures = [
  'Tablero de mando privado',
  'Agregar, editar y quitar propiedades',
  'Carga de fotos de alta calidad',
  'Administración de destacadas',
  'Presupuestos y fichas desde el móvil',
  'Gestión de información comercial',
  'Enlaces listos para compartir por WhatsApp',
];

const productShots = [
  {
    src: '/inmobiliarias/home.png',
    title: 'Primera impresión premium',
    benefit: 'Una home inmersiva que posiciona a la inmobiliaria antes de mostrar el catálogo.',
    alt: 'Home premium del portal Roggero y Roma con buscador principal sobre imagen de propiedad',
  },
  {
    src: '/inmobiliarias/buscador.png',
    title: 'Buscador y catálogo propio',
    benefit: 'Propiedades ordenadas, filtrables y presentadas con fotos, ubicación y precio.',
    alt: 'Buscador y grilla de propiedades del portal inmobiliario',
  },
  {
    src: '/inmobiliarias/destacadas.png',
    title: 'Propiedades destacadas',
    benefit: 'Espacios para empujar inmuebles clave y reforzar la oferta disponible.',
    alt: 'Sección de propiedades destacadas con métricas del portal inmobiliario',
  },
  {
    src: '/inmobiliarias/mapas.png',
    title: 'Ubicación y mapas',
    benefit: 'Cada inmueble puede mostrar contexto geográfico para consultas más informadas.',
    alt: 'Vista de mapa con propiedades geolocalizadas',
  },
  {
    src: '/inmobiliarias/resenas.png',
    title: 'Reseñas de Google integradas',
    benefit: 'Prueba social visible para generar confianza antes del primer mensaje.',
    alt: 'Panel de reseñas de Google integrado al sistema inmobiliario',
  },
  {
    src: '/inmobiliarias/panel.png',
    title: 'Panel de control',
    benefit: 'Un tablero interno para ver actividad, propiedades y estado del sistema.',
    alt: 'Panel privado de control del portal inmobiliario',
  },
  {
    src: '/inmobiliarias/edit.png',
    title: 'Carga y edición de propiedades',
    benefit: 'El equipo puede actualizar catálogo, fotos y datos desde una interfaz mobile.',
    alt: 'Pantalla móvil para cargar y editar propiedades en el CRM inmobiliario',
    orientation: 'portrait',
  },
  {
    src: '/inmobiliarias/presupuestos.png',
    title: 'Presupuestos desde móvil',
    benefit: 'Preparación de propuestas y fichas comerciales listas para enviar.',
    alt: 'Pantalla de emisión de propuesta o presupuesto desde el panel inmobiliario',
  },
];

const planFeatures = [
  'Portal público premium',
  'Catálogo de propiedades',
  'Fichas individuales',
  'Buscador y filtros',
  'WhatsApp por propiedad',
  'Panel privado / CRM',
  'Alta y edición de propiedades',
  'Presupuestos o fichas compartibles',
  'SEO por ficha',
];
---

<Layout title={title} description={description} ogImage={ogImage} canonical={canonical}>
  <div class="film-grain" aria-hidden="true"></div>

  <!-- ═══════════════ NAVIGATION ═══════════════ -->
  <nav id="nav-main" class="nav">
    <div class="nav__inner">
      <a href="/" class="nav__logo" id="nav-logo">
        <img src="/wolfim_logos/logo_wolfim_57UD10.svg" alt="Wolfim Studio" class="nav__logo-img" width="120" height="35">
      </a>
      <div class="nav__links" id="nav-links">
        <a href="/#projects" class="nav__link">Trabajos</a>
        <a href="/#capabilities" class="nav__link">Servicios</a>
        <a href="/#pricing" class="nav__link">Precios</a>
        <a href="/#process" class="nav__link">Proceso</a>
        <a href="/#contact" class="nav__link">Contacto</a>
      </div>
      <div class="nav__meta">
        <button class="lang-toggle" id="lang-toggle" aria-label="Idioma actual: español" type="button">
          <span class="lang-toggle__option" data-lang="en">EN</span>
          <span class="lang-toggle__divider">/</span>
          <span class="lang-toggle__option lang-toggle__option--active" data-lang="es">ES</span>
        </button>
        <span class="nav__time" id="nav-time"></span>
        <button class="nav__menu-btn" id="nav-menu-btn" aria-label="Toggle menu" type="button">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
    <div class="nav__line"></div>
  </nav>

  <!-- Mobile overlay -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu__close" id="mobile-menu-close" aria-label="Cerrar menú" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <div class="mobile-menu__inner">
      <div class="mobile-menu__links">
        <a href="/#projects" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span>Trabajos</span></a>
        <a href="/#capabilities" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span>Servicios</span></a>
        <a href="/#pricing" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span>Precios</span></a>
        <a href="/#process" class="mobile-menu__link"><span class="menu-link-prefix">/</span><span>Proceso</span></a>
      </div>
    </div>
  </div>

  <!-- ═══════════════ MAIN ═══════════════ -->
  <main class="inmo">
    <section class="inmo__hero">
      <div class="inmo__hero-grid">
        <div class="inmo__hero-copy">
          <span class="inmo__eyebrow">Caso real / Roggero &amp; Roma</span>
          <h1 class="inmo__headline">Caso real: Roggero &amp; Roma</h1>
          <p class="inmo__subtext">
            Modelo real en producción para una inmobiliaria de Córdoba: portal inmobiliario premium con catálogo, fichas, WhatsApp por propiedad y panel privado para administrar el catálogo desde el móvil.
          </p>
          <div class="inmo__hero-actions" aria-label="Acciones principales">
            <a href={whatsappUrl} class="inmo__btn inmo__btn--primary" target="_blank" rel="noopener noreferrer" data-cta="inmobiliarias_hero_primary">
              Quiero un portal para mi inmobiliaria
            </a>
            <a href="#sistema" class="inmo__btn inmo__btn--secondary">
              Ver portal + CRM
            </a>
          </div>
          <div class="inmo__proof-row" aria-label="Capacidades principales">
            <span>Catálogo visual</span>
            <span>Panel privado</span>
            <span>WhatsApp por propiedad</span>
          </div>
        </div>

        <div class="inmo__hero-visual" aria-label="Video del caso Roggero y Roma">
          <div class="inmo__visual-label">
            <span>Producto real en producción</span>
            <strong>Roggero &amp; Roma</strong>
          </div>
          <video class="inmo__hero-video" autoplay loop muted playsinline preload="auto" aria-label="Video del portal inmobiliario Roggero y Roma">
            <source src="/roggeroyroma_hero2.mp4" type="video/mp4">
          </video>
        </div>
      </div>
    </section>

    <div class="section__line inmo__divider"></div>

    <section id="sistema" class="section inmo__system" aria-labelledby="system-title">
      <div class="section__header">
        <span class="section__number">01</span>
        <h2 id="system-title" class="section__title">Dos partes<br>del sistema</h2>
        <p class="section__subtitle">La inmobiliaria no recibe solo una web: recibe presencia pública y operación interna.</p>
      </div>
      <div class="section__line"></div>

      <div class="inmo__system-grid">
        <article class="inmo__system-card">
          <span class="inmo__card-kicker">A / Web pública premium</span>
          <h3>La vidriera comercial</h3>
          <p>Un portal propio para elevar percepción de marca, ordenar el catálogo y convertir visitas en consultas concretas.</p>
          <ul>
            {publicFeatures.map((feature) => <li>{feature}</li>)}
          </ul>
        </article>

        <article class="inmo__system-card inmo__system-card--dark">
          <span class="inmo__card-kicker">B / Panel privado + CRM</span>
          <h3>La operación diaria</h3>
          <p>Un panel interno para que el equipo administre propiedades, destaque oportunidades y prepare material comercial sin depender del desarrollador.</p>
          <ul>
            {crmFeatures.map((feature) => <li>{feature}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <section class="section inmo__gallery" aria-labelledby="gallery-title">
      <div class="section__header">
        <span class="section__number">02</span>
        <h2 id="gallery-title" class="section__title">Así se ve<br>el sistema</h2>
        <p class="section__subtitle">Capturas reales del portal público y del panel privado usado para administrar propiedades.</p>
      </div>
      <div class="section__line"></div>

      <div class="inmo__shots-grid">
        {productShots.map((shot, index) => (
          <article class={`inmo__shot ${shot.orientation === 'portrait' ? 'inmo__shot--portrait' : ''}`}>
            <div class="inmo__shot-media">
              <img
                src={shot.src}
                alt={shot.alt}
                width="1920"
                height="919"
                loading="eager"
                decoding="async"
              >
            </div>
            <div class="inmo__shot-copy">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{shot.title}</h3>
              <p>{shot.benefit}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section inmo__not-web" aria-labelledby="not-web-title">
      <div class="inmo__not-web-inner">
        <span class="inmo__eyebrow inmo__eyebrow--light">No es solo una web</span>
        <h2 id="not-web-title">Es una herramienta comercial para ordenar propiedades y generar consultas.</h2>
        <p>
          No es solo una web institucional. Es una herramienta comercial para ordenar propiedades, elevar la percepción de marca y convertir visitas en consultas concretas por WhatsApp.
        </p>
        <ul>
          <li>Menos consultas desordenadas.</li>
          <li>Más confianza antes del primer mensaje.</li>
          <li>Propiedades mejor presentadas.</li>
          <li>Equipo con control para actualizar el catálogo.</li>
          <li>Fichas listas para compartir con interesados.</li>
        </ul>
      </div>
    </section>

    <section id="caso" class="section inmo__case" aria-labelledby="case-title">
      <div class="section__header">
        <span class="section__number">03</span>
        <h2 id="case-title" class="section__title">Qué demuestra<br>el caso</h2>
        <p class="section__subtitle">La prueba de que el producto es más que una landing: es portal, catálogo y operación.</p>
      </div>
      <div class="section__line"></div>

      <div class="inmo__case-grid">
        <div class="inmo__case-media">
          <video class="inmo__case-video" autoplay loop muted playsinline preload="metadata" aria-label="Video del portal inmobiliario Roggero y Roma">
            <source src="/roggeroyroma_hero2.mp4" type="video/mp4">
          </video>
        </div>

        <div class="inmo__case-content">
          <span class="inmo__case-label">Modelo real en producción</span>
          <p class="inmo__case-desc">
            Roggero &amp; Roma no recibió una plantilla genérica. Recibió un portal inmobiliario propio: catálogo, fichas, WhatsApp por propiedad, reseñas, mapas y administración interna.
          </p>
          <ul class="inmo__case-list">
            <li>Catálogo con buscador y filtros.</li>
            <li>Fichas individuales con galería y mapa.</li>
            <li>Consultas por WhatsApp desde cada inmueble.</li>
            <li>Reseñas y prueba social integradas.</li>
            <li>Panel privado para gestión operativa.</li>
          </ul>
          <div class="inmo__case-actions">
            <a href="https://roggeroyroma.com" class="inmo__btn inmo__btn--secondary" target="_blank" rel="noopener noreferrer" data-track-case>
              Ver sitio en producción ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section inmo__pricing" aria-labelledby="pricing-title">
      <div class="section__header">
        <span class="section__number">04</span>
        <h2 id="pricing-title" class="section__title">Inversión</h2>
        <p class="section__subtitle">Un portal inmobiliario con sistema de administración, no una web genérica.</p>
      </div>
      <div class="section__line"></div>

      <article class="inmo__offer-card" id="plan-portal-crm-inmobiliario">
        <div class="inmo__offer-head">
          <div>
            <span class="inmo__card-kicker">Inmobiliarias</span>
            <h3>Portal + CRM Inmobiliario</h3>
          </div>
          <div class="inmo__price-box" aria-label="Precio desde USD 450 más USD 39 por mes">
            <span>Desde</span>
            <strong>USD 450</strong>
            <em>+ USD 39/mes</em>
          </div>
        </div>

        <ul class="inmo__offer-features">
          {planFeatures.map((feature) => <li>{feature}</li>)}
        </ul>

        <p class="inmo__offer-note">
          El alcance final depende de cantidad de propiedades, integraciones, carga inicial y nivel de automatización requerido.
        </p>

        <a href={whatsappUrl} class="inmo__btn inmo__btn--primary inmo__offer-cta" target="_blank" rel="noopener noreferrer" data-cta="inmobiliarias_pricing">
          Quiero este sistema →
        </a>
      </article>
    </section>

    <section class="section inmo__cta-section" aria-labelledby="cta-title">
      <div class="inmo__cta-inner">
        <span class="inmo__eyebrow">Próximo paso</span>
        <h2 id="cta-title" class="inmo__cta-title">¿Querés un portal inmobiliario que también ordene tu operación?</h2>
        <p class="inmo__cta-desc">
          Mostrá mejor tus propiedades, centralizá consultas por WhatsApp y administrá tu catálogo desde un panel propio.
        </p>
        <a href={whatsappUrl} class="inmo__btn inmo__btn--primary" target="_blank" rel="noopener noreferrer" data-cta="inmobiliarias_final">
          Quiero ver cómo quedaría mi portal
        </a>
      </div>
    </section>
  </main>

  <!-- ═══════════════ FOOTER ═══════════════ -->
  <footer class="footer">
    <div class="footer__line"></div>
    <div class="footer__inner">
      <div class="footer__left">
        <span class="footer__logo">WOLFIM STUDIO</span>
        <span class="footer__copy">Wolfim Studio 2026</span>
      </div>
      <div class="footer__right">
        <a href="/" class="footer__link">Inicio</a>
        <a href={whatsappUrl} class="footer__link" target="_blank" rel="noopener noreferrer" data-cta="inmobiliarias_footer">WhatsApp</a>
      </div>
    </div>
  </footer>

  <!-- WhatsApp Sticky -->
  <a href={whatsappUrl} class="whatsapp-sticky" target="_blank" rel="noopener noreferrer" aria-label="Chatear por WhatsApp" data-cta="inmobiliarias_sticky">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
      <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
    </svg>
  </a>

  <script>
    import { trackEvent } from '../lib/analytics';
    import { captureUTMs } from '../lib/utm';

    captureUTMs();

    const nav = document.getElementById('nav-main');
    const menuBtn = document.getElementById('nav-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('mobile-menu-close');
    const timeEl = document.getElementById('nav-time');
    let lastScrollY = 0;

    nav?.classList.add('is-loaded');

    const updateTime = () => {
      if (!timeEl) return;
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      timeEl.textContent = `${h}:${m}:${s}`;
    };

    updateTime();
    window.setInterval(updateTime, 1000);

    const closeMobileMenu = () => {
      mobileMenu?.classList.remove('active');
      menuBtn?.classList.remove('open', 'active');
      document.body.style.overflow = '';
    };

    menuBtn?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.toggle('active');
      menuBtn.classList.toggle('open', Boolean(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    closeBtn?.addEventListener('click', closeMobileMenu);

    document.querySelectorAll('.mobile-menu__link').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    window.addEventListener('scroll', () => {
      if (!nav) return;
      const scrollY = window.scrollY;
      nav.classList.toggle('is-scrolled', scrollY > 20);
      if (scrollY > 300 && scrollY > lastScrollY) {
        nav.classList.add('nav--hidden');
      } else {
        nav.classList.remove('nav--hidden');
      }
      lastScrollY = scrollY;
    }, { passive: true });

    document.querySelectorAll<HTMLAnchorElement>('a[href*="wa.me"]').forEach((link) => {
      link.addEventListener('click', () => {
        trackEvent('click_whatsapp', {
          component: link.dataset.cta || 'inmobiliarias',
          cta_label: link.textContent?.trim() || link.getAttribute('aria-label') || 'WhatsApp',
        });
      });
    });

    document.querySelector('[data-track-case]')?.addEventListener('click', () => {
      trackEvent('click_case_external', { component: 'roggero_roma_case' });
    });
  </script>

  <style>
    .inmo {
      position: relative;
      background: #FAFAF8;
      color: var(--black);
    }

    .inmo__hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: calc(60px + var(--space-md)) var(--container-padding) var(--space-md);
    }

    .inmo__hero-grid {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
      gap: clamp(2rem, 5vw, 6rem);
      align-items: center;
    }

    .inmo__hero-copy {
      max-width: 760px;
    }

    .inmo__eyebrow,
    .inmo__card-kicker,
    .inmo__case-label {
      display: inline-flex;
      font-family: var(--font-mono);
      font-size: var(--text-micro);
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--gray-400);
      margin-bottom: 1rem;
    }

    .inmo__eyebrow--light {
      color: rgba(245, 245, 240, 0.62);
    }

    .inmo__headline {
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 6.5vw, 6.4rem);
      font-weight: 700;
      line-height: 0.96;
      letter-spacing: -0.06em;
      color: var(--black);
      margin-bottom: 1.4rem;
      max-width: 980px;
    }

    .inmo__subtext {
      font-family: var(--font-body);
      font-size: clamp(1.02rem, 1.45vw, 1.28rem);
      line-height: 1.65;
      color: var(--gray-500);
      max-width: 690px;
      margin-bottom: 2rem;
    }

    .inmo__hero-actions,
    .inmo__case-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
      align-items: center;
    }

    .inmo__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0.95rem 1.35rem;
      font-family: var(--font-mono);
      font-size: var(--text-micro);
      letter-spacing: 0.09em;
      text-transform: uppercase;
      border: 1px solid var(--black);
      transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    }

    .inmo__btn:hover {
      transform: translateY(-2px);
    }

    .inmo__btn--primary {
      background: var(--black);
      color: var(--white);
    }

    .inmo__btn--primary:hover {
      background: var(--gray-500);
      border-color: var(--gray-500);
    }

    .inmo__btn--secondary {
      background: transparent;
      color: var(--black);
    }

    .inmo__btn--secondary:hover {
      background: var(--black);
      color: var(--white);
    }

    .inmo__proof-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 2rem;
    }

    .inmo__proof-row span {
      border: 1px solid var(--border);
      padding: 0.55rem 0.75rem;
      font-family: var(--font-mono);
      font-size: var(--text-micro);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gray-500);
      background: rgba(255,255,255,0.42);
    }

    .inmo__hero-visual {
      position: relative;
      border: 1px solid var(--border-strong);
      background: var(--black);
      overflow: hidden;
      box-shadow: 0 28px 80px rgba(10, 10, 10, 0.12);
    }

    .inmo__hero-visual img,
    .inmo__hero-video {
      width: 100%;
      height: 100%;
      min-height: 420px;
      object-fit: cover;
      opacity: 0.92;
      display: block;
    }

    .inmo__visual-label {
      position: absolute;
      left: 1rem;
      right: 1rem;
      top: 1rem;
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 0.85rem 1rem;
      background: rgba(10, 10, 10, 0.72);
      color: var(--white);
      backdrop-filter: blur(10px);
    }

    .inmo__visual-label span,
    .inmo__visual-label strong {
      font-family: var(--font-mono);
      font-size: var(--text-micro);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .inmo__visual-label span {
      color: rgba(245,245,240,0.68);
      font-weight: 400;
    }

    .inmo__visual-label strong {
      color: var(--white);
      font-weight: 500;
    }

    .inmo__divider {
      margin: 0 var(--container-padding);
    }

    .inmo__system-grid {
      display: grid;
